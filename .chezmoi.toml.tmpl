{{- $machineRole := promptStringOnce . "machine_role" "Machine role (work/client/personal)" -}}

{{- $email := "" -}}
{{- if eq $machineRole "work" -}}
{{-   $email = promptStringOnce . "email" "Work email address" -}}
{{- else if eq $machineRole "client" -}}
{{-   $email = promptStringOnce . "email" "Client email address" -}}
{{- else -}}
{{-   $email = promptStringOnce . "email" "Personal email address" -}}
{{- end -}}

{{- /* Auto-sync schedule. Default per role; the prompt lets any machine override.
       workday = morning + end-of-work, evening = end-of-work + night, both = all three,
       off = no scheduled sync. The clock times live in [data.sync_times] below so they're
       editable without touching the plist. */ -}}
{{- $syncDefault := "off" -}}
{{- if eq $machineRole "work" -}}{{- $syncDefault = "workday" -}}
{{- else if eq $machineRole "personal" -}}{{- $syncDefault = "evening" -}}{{- end -}}
{{- $syncSchedule := promptChoiceOnce . "sync_schedule" "Auto-sync schedule (workday/evening/both/off)" (list "workday" "evening" "both" "off") $syncDefault -}}

{{- /* Which package bundles this machine installs. Default per role; the prompt lets any
       machine override, and [data] bundles below stays editable afterward. The same map
       lives in .chezmoitemplates/bundles, which answers this at render time for machines
       that predate the key. Prompt functions only exist while this file renders, so the
       duplication is unavoidable: change one, change the other. */ -}}
{{- $bundleCatalog := list "core" "fonts" "dev" "browsers" "media" "office" "ai" "personal-apps" "cloud" -}}
{{- $bundleDefault := list "core" "fonts" "dev" "browsers" "media" "office" -}}
{{- if eq $machineRole "personal" -}}{{- $bundleDefault = concat $bundleDefault (list "ai" "personal-apps") -}}
{{- else if eq $machineRole "work" -}}{{- $bundleDefault = concat $bundleDefault (list "ai" "personal-apps" "cloud") -}}{{- end -}}
{{- $bundles := promptMultichoiceOnce . "bundles" "Package bundles" $bundleCatalog $bundleDefault -}}

encryption = "age"

[data]
  machine_role = {{ $machineRole | quote }}
  email = {{ $email | quote }}
  name = "Kendrick Arnett"
  sync_schedule = {{ $syncSchedule | quote }}
  # Packages this machine installs, by bundle. Edit and re-apply to add or drop one;
  # .chezmoidata.toml is what says which packages each bundle holds.
  bundles = {{ $bundles | toJson }}
  # Clock times the schedule presets draw from. Edit here and re-apply to reschedule.
  [data.sync_times]
    workday_start = "10:00"
    workday_end = "16:00"
    evening_end = "22:00"

[age]
  identity = {{ (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") | quote }}
  recipient = "age1xy04pcarcglpwfafwenw8z7aygv2sknl54jvfrd0c0zlww328fnsrakm7x"
