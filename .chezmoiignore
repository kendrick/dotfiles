# Repo infrastructure — never deploy to $HOME
README.md
AGENTS.md
CLAUDE.md
.gitignore
.github
_working-memory
scripts

# VS Code extension list: source-only data the install script reads via include,
# generated from `code --list-extensions`. Deploying it let the daily re-add clobber
# each regenerated list with the stale deployed copy, so keep it out of $HOME.
.config/vscode-extensions.txt

# ~/.config/Brewfile isn't deployed: the package installer renders the Brewfile
# inline (brew bundle --file=/dev/stdin), so a deployed copy just goes stale and
# unused. The real data lives in .chezmoitemplates/Brewfile.
.config/Brewfile

# Claude Desktop — device-specific state, don't sync
private_Library/private_Application Support/Claude/claude_desktop_config.json

# awssso — work machine only
{{ if ne .machine_role "work" }}
dot_local/bin/executable_awssso
{{ end }}

# Age-encrypted Claude config. chezmoi decrypts encrypted_ targets unconditionally
# on apply, so a fresh machine with no ~/.config/chezmoi/key.txt aborts the whole
# run on the first one. Skip them while the key is absent and the rest of the
# bootstrap (brew, vscode, zsh, git, …) still lands; seed the key, re-apply, and
# these come in on the next pass. The plugin reinstall script guards the same way.
{{ if not (stat (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt")) }}
.claude/settings.json
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
{{ end }}
