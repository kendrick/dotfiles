# Repo infrastructure — never deploy to $HOME
README.md
AGENTS.md
CLAUDE.md
.gitignore
.github
_working-memory
scripts
tests

# Install-manifest lists: source-only data the run_onchange installers read via
# `include`, deliberately not deployed to $HOME. The wrappers in
# dot_config/zsh/functions.zsh rewrite the vscode/npm/pnpm lists straight into
# source on `code --install-extension` / `npm -g` / `pnpm -g`, so a deployed copy
# just lets the daily re-add clobber each fresh list with the stale deployed one.
# raycast-extensions.txt is hand-edited, but nothing reads its deployed copy
# either, so it follows the same rule.
.config/vscode-extensions.txt
.config/npm-globals.txt
.config/pnpm-globals.txt
.config/raycast-extensions.txt

# ~/.config/Brewfile isn't deployed: the package installer renders the Brewfile
# inline (brew bundle --file=/dev/stdin), so a deployed copy just goes stale and
# unused. The real data lives in .chezmoidata.toml, which chezmoi never deploys
# either, because source entries starting with a dot have no target at all.
.config/Brewfile

# Claude Desktop — device-specific state, don't sync
private_Library/private_Application Support/Claude/claude_desktop_config.json

# awssso — work machine only
{{ if ne .machine_role "work" }}
dot_local/bin/executable_awssso
{{ end }}

# Age-encrypted Claude config. chezmoi decrypts encrypted_ targets unconditionally
# on apply, so a fresh machine with no ~/.config/chezmoi/key.txt aborts the whole
# run on the first one. Skip them while the key is absent and the rest of the
# bootstrap (brew, vscode, zsh, git, …) still lands; seed the key, re-apply, and
# these come in on the next pass. The plugin reinstall script guards the same way.
{{ if not (stat (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt")) }}
.claude/settings.json
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
{{ end }}

# Auto-sync off: don't deploy the LaunchAgent plist. The load script also unloads and
# removes any copy already on disk, so toggling to off actually stops the scheduled sync.
# Missing sync_schedule (a machine that predates the prompt) falls back to the role default.
{{ $rd := ternary "workday" (ternary "evening" "off" (eq .machine_role "personal")) (eq .machine_role "work") }}
{{ if eq (get . "sync_schedule" | default $rd) "off" }}
Library/LaunchAgents/com.k-arnett.dotfiles-auto-sync.plist
{{ end }}

# Per-machine deploy key for the quantified-claude events repo. The github-qc-events
# ssh stanza (in private_dot_ssh/config) IS synced, but the key itself stays local:
# each machine generates its own and registers its own read-write deploy key, so one
# machine can be revoked without touching the others. Never let this into the repo.
.ssh/quantified_claude_events_deploy
.ssh/quantified_claude_events_deploy.pub
