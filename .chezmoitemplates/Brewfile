{{- /* Generated from .chezmoidata.toml. Nothing to edit here: add or move a package there
       and re-apply. Emitted in tap, brew, cask, mas order: `brew bundle` walks the file
       top to bottom, so a tapped formula whose tap hasn't been declared yet fails, and
       run_onchange_install-packages.sh.tmpl trusts taps by scanning for lines matching
       `^tap `, which means they have to land at column 0. Both are asserted in
       tests/packages.bats.

       Built by appending to a list and joining at the end rather than emitting inside the
       loops. Every line then starts at column 0 by construction instead of by getting the
       {{- -}} trimming right in eight places. */ -}}
{{- $enabled := includeTemplate "bundles" . | fromJson -}}
{{- /* Entries this machine's macOS is too old for (.chezmoitemplates/os-held), keyed
       type/name because names can collide across types and a cask and a formula
       sharing one name must not hold each other back. Read at RENDER time — see that
       partial's own header for why an install-time read would leave zappy stuck. */ -}}
{{- $held := dict -}}
{{- range $h := (includeTemplate "os-held" . | fromJson) -}}
{{-   $held = set $held (printf "%s/%s" $h.type $h.name) true -}}
{{- end -}}
{{- $lines := list -}}
{{- range $t := .pkg.taps -}}
{{-   $hit := false -}}
{{-   range $b := $t.bundles }}{{ if has $b $enabled }}{{ $hit = true }}{{ end }}{{ end -}}
{{-   if $hit }}{{ $lines = append $lines (printf "tap \"%s\"" $t.name) }}{{ end -}}
{{- end -}}
{{- $on := list -}}
{{- range $p := .pkg.packages -}}
{{-   $hit := false -}}
{{-   range $b := $p.bundles }}{{ if has $b $enabled }}{{ $hit = true }}{{ end }}{{ end -}}
{{-   if and $hit (not (hasKey $held (printf "%s/%s" $p.type $p.name))) }}{{ $on = append $on $p }}{{ end -}}
{{- end -}}
{{- range $p := $on }}{{ if eq $p.type "brew" }}{{ $lines = append $lines (printf "brew \"%s\"" $p.name) }}{{ end }}{{ end -}}
{{- range $p := $on }}{{ if eq $p.type "cask" }}{{ $lines = append $lines (printf "cask \"%s\"" $p.name) }}{{ end }}{{ end -}}
{{- range $p := $on }}{{ if eq $p.type "mas" }}{{ $lines = append $lines (printf "mas \"%s\", id: %d" $p.name $p.id) }}{{ end }}{{ end -}}
{{ join "\n" $lines }}
