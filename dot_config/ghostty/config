theme = dark:Synthwave Everything,light:Light Owl
# Light Owl's bright white is 1.1:1 against its background, so text drawn in it vanishes.
# 2 lifts anything that faint, from any program, and barely touches the rest of either palette.
minimum-contrast = 2
# BEGIN font (managed by `font`)
font-family = "RecMonoLinear Nerd Font"
font-size = 14
font-feature = calt
# END font
cursor-style = block
shell-integration-features = no-cursor
keybind = shift+enter=text:\x1b\r
config-file = ?tode/keybinds.ghostty

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"
# <<< herdr-radar font block
