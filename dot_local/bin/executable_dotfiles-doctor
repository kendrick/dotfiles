#!/bin/bash
# dotfiles-doctor — report config drift between this machine and the dotfiles repo.
# Read-only: it changes nothing, it just shows you what's out of sync so you can
# decide what to do. Worth running after `chezmoi update`, because update only ADDS
# — it never removes an extension or package you dropped on another machine.
set -euo pipefail

SRC="$(chezmoi source-path)"

echo "== VS Code extensions =="
if command -v code &>/dev/null; then
  list="$SRC/dot_config/vscode-extensions.txt"
  installed="$(code --list-extensions | sort)"
  listed="$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$list" | sort)"
  echo "-- here but not in your dotfiles (uninstall, or capture with dotfiles-sync):"
  comm -23 <(echo "$installed") <(echo "$listed") | sed 's/^/    /'
  echo "-- in your dotfiles but not installed (next apply installs these):"
  comm -13 <(echo "$installed") <(echo "$listed") | sed 's/^/    /'
else
  echo "    code CLI not found — skipping"
fi

echo
echo "== Homebrew =="
# Packages are data now (GitHub #4), so this compares against .chezmoidata.toml narrowed to
# the bundles this machine turned on, not against Brewfile text. Both lists come back through
# `chezmoi execute-template` rather than being parsed here: it's the same parser the render
# uses, so there's no second reader to drift from the first.
#
# A package installed from a bundle this machine hasn't enabled stays silent on purpose.
# You already decided about that one, and apply never uninstalls, so saying it out loud
# would be a complaint with no way to end it. dotfiles-apps is where that gets acted on.
if command -v brew &>/dev/null && command -v jq &>/dev/null; then
  bundles="$(chezmoi execute-template '{{ template "bundles" . }}')"
  pkgs="$(chezmoi execute-template '{{ .pkg.packages | toJson }}')"

  # Two spellings of every tapped formula, because brew uses both: `brew leaves` reports
  # them qualified (sbcinnovation/tap/squoosh) and `brew list --formula` reports them bare.
  # Carrying both means neither direction of the comparison invents drift that isn't there.
  tracked_brew="$(jq -r --argjson b "$bundles" '
    .[] | select(.type == "brew") | select(.bundles | any(IN($b[]))) | .name' <<<"$pkgs")"
  tracked_brew_any="$(jq -r --argjson b "$bundles" '
    .[] | select(.type == "brew") | select(.bundles | any(IN($b[])))
    | .name, (.name | split("/") | last)' <<<"$pkgs")"
  tracked_cask="$(jq -r --argjson b "$bundles" '
    .[] | select(.type == "cask") | select(.bundles | any(IN($b[]))) | .name' <<<"$pkgs")"

  echo "-- here but not tracked at all (add it to .chezmoidata.toml, or uninstall):"
  while IFS= read -r formula; do
    grep -qxF "$formula" <<<"$tracked_brew_any" || echo "    brew  $formula"
  done < <(brew leaves)
  while IFS= read -r cask; do
    grep -qxF "$cask" <<<"$tracked_cask" || echo "    cask  $cask"
  done < <(brew list --cask 2>/dev/null)

  # Against `brew list`, not `brew leaves`: a tracked formula that something else depends on
  # isn't a leaf, and comparing to leaves would report it missing on every single run.
  echo "-- in a bundle you've enabled but not installed (next apply installs these):"
  installed_brew="$(brew list --formula)"
  installed_cask="$(brew list --cask 2>/dev/null)"
  while IFS= read -r formula; do
    [[ -n "$formula" ]] || continue
    grep -qxF "${formula##*/}" <<<"$installed_brew" || echo "    brew  $formula"
  done <<<"$tracked_brew"
  while IFS= read -r cask; do
    [[ -n "$cask" ]] || continue
    grep -qxF "$cask" <<<"$installed_cask" || echo "    cask  $cask"
  done <<<"$tracked_cask"
else
  echo "    brew or jq not found — skipping"
fi

echo
echo "== Config dependencies =="
# The Homebrew section above is the right check on the wrong axis. It compares what's
# installed against what's tracked, and never asks whether a managed config names a
# resource the Brewfile is supposed to provide. A font hand-dropped into ~/Library/Fonts
# satisfies neither side of that comparison, so it looks like nothing is wrong.
#
# That's how Fantasque went years unnoticed: the configs named it, the Brewfile installed
# no fonts at all, and the gap only surfaced on a fresh MacBook as a p10k prompt full of
# replacement boxes. macOS substitutes silently for a family it can't resolve, so there's
# no error anywhere to catch: the config stays valid and the apply succeeds.
#
# Fonts are the only resource checked here so far, since fonts are what bit. Each half of
# each registry entry declares the casks that provide the families it names, and this
# asserts the package registry carries them. An empty list means "not from Homebrew" and is
# only legal on Tier C, the licensed fonts fetched from 1Password. A missing key means
# someone added a roster entry and never said where the bytes come from, which is its own gap.
#
# Narrowed to enabled bundles, unlike the Homebrew section above. A machine that turned the
# fonts bundle off has configs naming families nothing will install, which is exactly the
# failure described above rather than a choice already made. In practice fonts is in every
# role's defaults, so this reads the same as it always has.
if command -v jq &>/dev/null; then
  registry="$SRC/dot_config/font/registry.json"
  dep_gaps=0
  if [[ -f "$registry" ]]; then
    dep_bundles="$(chezmoi execute-template '{{ template "bundles" . }}')"
    dep_casks="$(chezmoi execute-template '{{ .pkg.packages | toJson }}' | jq -r --argjson b "$dep_bundles" '
      .[] | select(.type == "cask") | select(.bundles | any(IN($b[]))) | .name')"
    echo "-- fonts the registry names that no enabled bundle installs:"
    while IFS=$'\t' read -r key half cask; do
      if [[ "$cask" == "!undeclared" ]]; then
        echo "    $key  $half  has no \"casks\" key — name the casks it needs, or [] if it's licensed"
        dep_gaps=1
      # Whole-line exact match against the cask set, so a formula of the same name can't
      # satisfy a cask dependency and `font-lilex` can't be answered by `font-lilex-nerd-font`.
      # Both used to ride on the shape of a grep against Brewfile text; the type filter and
      # the -x now carry them structurally.
      elif ! grep -qxF "$cask" <<<"$dep_casks"; then
        echo "    $key  $half  $cask"
        dep_gaps=1
      fi
    done < <(jq -r '
      to_entries[]
      | .key as $key
      | .value.tier as $tier
      | (["terminal", "editor"][]) as $half
      | .value[$half] as $cfg
      | if ($cfg | has("casks") | not) then "\($key)\t\($half)\t!undeclared"
        elif (($cfg.casks | length) == 0 and $tier != "c") then "\($key)\t\($half)\t!undeclared"
        else ($cfg.casks[] | "\($key)\t\($half)\t\(.)")
        end
    ' "$registry")
    [[ "$dep_gaps" -eq 0 ]] && echo "    none — every family the registry names comes from a cask you track"
  else
    echo "    font registry not found at $registry — skipping"
  fi
else
  echo "    jq not found — skipping"
fi

echo
echo "== Template drift =="
# re-add won't reverse-render a template, so a templated file an app rewrites in
# $HOME (Claude's settings.json is the classic) drifts without ever being captured
# by dotfiles-sync. Flag any managed template whose live copy diverged from source.
tmpl_drift=0
while IFS= read -r line; do
  [[ "${line:1:1}" == "M" || "${line:1:1}" == "D" ]] || continue
  tgt="${line:3}"
  src="$(chezmoi source-path "$HOME/$tgt" 2>/dev/null)" || continue
  if [[ "$src" == *.tmpl ]]; then
    echo "    $tgt  (edit the source template, or reconcile by hand)"
    tmpl_drift=1
  fi
done < <(chezmoi status)
[[ "$tmpl_drift" -eq 0 ]] && echo "    none — templated files match their source"

echo
echo "== Teardown coverage =="
# dotfiles-teardown derives the encrypted targets from chezmoi, but anything a script
# leaves outside chezmoi's view (the gh token, the SSO cache) is invisible to it. Those
# get declared as `# teardown:<class> <path>` next to the code that creates them. A script
# with no declaration at all is the drift case: it might leave a credential behind and
# nothing would know. `none` is a valid answer, it just has to be said out loud.
#
# Only run_ scripts are required to declare. They're the provisioners, so they're where
# new machine state comes from. Scripts in dot_local/bin may declare too (awssso does, for
# the SSO cache) and teardown reads them, but demanding a comment from `draw` and `cless`
# would make this section cry wolf until nobody reads it.
undeclared=0
while IFS= read -r f; do
  grep -qI '^# teardown:' "$f" || { echo "    $(basename "$f")"; undeclared=1; }
done < <(find "$SRC" -maxdepth 1 -name 'run_*' -type f)
if [[ "$undeclared" -eq 1 ]]; then
  echo "    ^ no '# teardown:' line. Add one (secret/data/none) so teardown can see it."
else
  echo "    none — every run_ script declares what it leaves behind"
fi
