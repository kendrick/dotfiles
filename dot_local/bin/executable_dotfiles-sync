#!/bin/bash
# dotfiles-sync — auto-sync this machine's $HOME → chezmoi source → remote.
#
# Runs daily via launchd (see ~/Library/LaunchAgents/com.k-arnett.dotfiles-auto-sync.plist).
# Also runnable by hand. Each phase is wrapped to catch known failure modes and
# fire a macOS notification with a concrete next step. Full output goes to
# ~/.local/state/dotfiles/last-sync.log for forensic poking.
#
# Deliberately NOT doing:
#   - Auto-editing the package registry. Which bundles a package belongs to is a
#     judgement a flat `brew bundle dump` has no way to make and would erase.
#     Drift gets noted in the log; dotfiles-apps is where you act on it.
#   - Capturing Raycast extensions. No CLI for listing them.
#   - Touching anything in ~/.config/gh. Auth tokens stay in $HOME only.

set -euo pipefail

SRC="$(chezmoi source-path)"
HOST="$(hostname -s)"
LOGDIR="$HOME/.local/state/dotfiles"
LOG="$LOGDIR/last-sync.log"
mkdir -p "$LOGDIR"
: >"$LOG"  # truncate log each run

# Mirror stdout/stderr to the log without losing terminal output for interactive runs.
exec > >(tee -a "$LOG") 2>&1

notify() {
  # Args: title, body
  osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
}

notify_fail() {
  # Args: short message for notification body
  notify "Dotfiles sync failed" "$1"
}

# ---- Phase: regenerate VS Code extension list ----
echo "==> Regenerating VS Code extension list"
if command -v code &>/dev/null; then
  list="$SRC/dot_config/vscode-extensions.txt"
  {
    echo "# VS Code extensions to install"
    echo "# Edit this list and run \`chezmoi apply\` to sync."
    code --list-extensions | sort -f
  } >"$list"
  echo "    updated dot_config/vscode-extensions.txt"
else
  echo "    code CLI not found, skipping"
fi

# ---- Phase: Claude plugin manifests ----
# Not a re-add: those manifests are no longer chezmoi targets, because the CLI writes
# machine-local paths into them and syncing that verbatim made every concurrent sync
# collide. claude-plugins-capture normalizes them to portable intent instead. The
# in-app /plugin menu skips the zsh wrapper, so this daily pass is the safety net.
echo "==> Capturing Claude plugin manifests"
if command -v claude-plugins-capture &>/dev/null; then
  claude-plugins-capture || echo "    ! plugin capture failed, continuing"
else
  echo "    claude-plugins-capture not found, skipping"
fi

# ---- Phase: preflight (has source moved ahead of this machine?) ----
# 2026-08-07 (2787c16) and 2026-08-09 (ffc481d): source picked up commits this machine
# never applied, the re-add below captured the stale live copies back over them, and the
# commit phase shipped the reversion. Restored by hand in 60637c4 and f1239d3.
#
# Comparing commit time to live mtime (arm 2 below) catches most of that, but it's a
# timestamp race, not a direction check: an edit that was staged but never committed never
# advances anything the comparison reads, and a live file rewritten with identical bytes,
# routine for an app that resaves its own config, bumps mtime without meaning anything.
# `chezmoi status`'s row code is a second, corroborating signal for the case timestamps
# can't settle. Measured against chezmoi v2.72.0: ordinary live drift (what re-add exists
# for) prints "MM", both columns, while an unapplied source edit (issue #29's two rows)
# prints " M": column 1 blank, meaning the live file hasn't been rewritten since chezmoi
# last applied it. Column 1 only corroborates, though. Delete chezmoi's persistent state,
# or run on a machine that's never applied these files, and every row collapses to " M"
# the same way, so a guard that trusts a blank column 1 alone refuses every first-run
# capture. See guard_decide's arm 3 below for how the two signals combine.
#
# Has to run before the re-add. Afterwards source equals live for every capturable file
# and the evidence is gone. That's also why this can't fold into the template-drift loop
# below despite both reading `chezmoi status`: that one asks what capture structurally
# missed, which is only answerable from post-re-add state.
echo "==> Checking whether source moved ahead of this machine"

# launchd hands this script a minimal PATH with no Homebrew on it, so `age` has to be
# found by more than a PATH lookup or every encrypted path degrades on every unattended
# run. The identity path matches this repo's own chezmoi.toml ([age].identity); there's no
# way to ask chezmoi for it instead, since chezmoi is the thing this guard exists to check.
AGE_IDENTITY="$HOME/.config/chezmoi/key.txt"
AGE_BIN=""
if command -v age &>/dev/null; then
  AGE_BIN="$(command -v age)"
else
  for age_candidate in /opt/homebrew/bin/age /usr/local/bin/age /usr/bin/age /opt/local/bin/age; do
    if [ -x "$age_candidate" ]; then
      AGE_BIN="$age_candidate"
      break
    fi
  done
fi

# Resolves one commit's target state for one path: the bytes chezmoi would write to
# $HOME, not the bytes git tracked. For an encrypted_ source those differ, since the
# tracked blob is age ciphertext, so arm 3 below would read every encrypted path as
# permanently drifted without decrypting first. Never fails loudly: an unresolvable
# commit (no key, no age binary, a corrupt blob) just leaves $3 empty, which the caller
# reads as "doesn't match" rather than a crash.
resolve_target_state() {
  local rev="$1" rel="$2" out="$3"
  : >"$out"
  case "$rel" in
  *.age)
    [ -n "$AGE_BIN" ] && [ -f "$AGE_IDENTITY" ] || return 0
    git -C "$SRC" show "$rev:$rel" 2>/dev/null | "$AGE_BIN" -d -i "$AGE_IDENTITY" >"$out" 2>/dev/null || : >"$out"
    ;;
  *)
    git -C "$SRC" show "$rev:$rel" >"$out" 2>/dev/null || : >"$out"
    ;;
  esac
  return 0
}

# The whole BLOCK/PROCEED decision, and the only place it's made. Takes the four axis
# values below and nothing else: no global, no command substitution, no file test. That's
# not caution for its own sake. Fourteen earlier attempts at this guard each smuggled the
# decision through a condition on something else instead, a file's size, its nesting, how
# many targets were queued, and each one held for a while and then quietly lost a real
# file. A function that structurally cannot see any of that can't be made to depend on it
# again by accident.
guard_decide() {
  local col1="$1" src="$2" live="$3" ct="$4"
  # Arm 1: the source working copy itself carries an edit re-add would destroy. No commit
  # holds it, so nothing past this point can recover it either. This reads the tracked
  # bytes directly rather than the source file's own mtime, which a checkout, a restore,
  # or re-add itself all rewrite.
  if [ "$src" = "edited" ]; then
    printf 'BLOCK'
    return
  fi
  # Arm 2: today's comparison, unchanged. A commit this machine never applied is newer
  # than what it last wrote to $HOME.
  if [ "$ct" = "ahead" ]; then
    printf 'BLOCK'
    return
  fi
  # Arm 3: the live file hasn't moved since the last apply (col1 blank), and its bytes
  # belong to some commit other than what source now holds: source moved on while this
  # machine's copy sat still. "near" and "far" mean the same thing here; only the distance
  # differs, and this rule was never supposed to care about that. Gating on col1 keeps a
  # file that's genuinely drifted back onto an old value (col1 "M") out of this arm; that's
  # ordinary drift, the thing re-add exists for, not source moving ahead.
  if [ "$col1" = " " ] && { [ "$live" = "near" ] || [ "$live" = "far" ]; }; then
    printf 'BLOCK'
    return
  fi
  printf 'PROCEED'
}

behind=()
while IFS= read -r line; do
  [[ "${line:1:1}" == "M" ]] || continue
  tgt="${line:3}"
  src="$(chezmoi source-path "$HOME/$tgt" 2>/dev/null)" || continue
  # A template can't be captured backwards, since re-add won't reverse-render one, so
  # there's nothing here to protect. The drift phase below picks up templates that
  # drifted live; a template whose source moved ahead is reported by neither phase, which
  # is deliberate—that's the case the old column-1 read was mislabeling as live drift.
  case "$src" in
  *.tmpl) continue ;;
  esac
  # Every degradation past this point skips the file rather than blocking the sync, which
  # is the right direction for an unattended job. A source path with no commits is the one
  # that needs its own test: git reports success with empty output, and `-gt` would read
  # that as 0 and trip on everything. A missing live file, a git error, and a source dir
  # that isn't a repo all fail their substitution instead.
  committed="$(git -C "$SRC" log -1 --format=%ct -- "$src" 2>/dev/null)" || continue
  [ -n "$committed" ] || continue
  live_mtime="$(stat -f %m "$HOME/$tgt" 2>/dev/null)" || continue

  # The four axes below are computed fresh for this target and this target only. A value
  # hoisted above this loop would carry the previous target's answer into whichever
  # target's own computation exits early next, invisibly to any test that only ever runs
  # one target at a time — see "the decision table holds when many targets share one run".
  ax_col1="${line:0:1}"
  ax_ct="behind"
  [ "$committed" -gt "$live_mtime" ] && ax_ct="ahead"

  # src axis: does the source working copy differ from its own committed HEAD? git show
  # wants a path relative to the repo root for the "rev:path" form, unlike the log/rev-list
  # pathspecs above, which take $src as chezmoi handed it back. A raw byte comparison is
  # correct even for an encrypted_ path; re-add destroys an uncommitted edit whether or not
  # anyone can read the plaintext underneath it.
  ax_rel="${src#"$SRC"/}"
  ax_src="clean"
  cmp -s "$src" <(git -C "$SRC" show "HEAD:$ax_rel" 2>/dev/null) || ax_src="edited"

  # live axis: walk every commit this path has ever held, no bound, since a windowed walk
  # misses exactly the old commit a drifted-back or stale-behind file is sitting on, and
  # stop the moment the live file's bytes match one's target state. Index 0 is HEAD;
  # anything found after it is "some other commit," which arm 3 treats the same as near or
  # far without needing to know which.
  ax_live="none"
  ax_idx=0
  while IFS= read -r ax_rev; do
    ax_target="$(mktemp)"
    resolve_target_state "$ax_rev" "$ax_rel" "$ax_target"
    if cmp -s "$ax_target" "$HOME/$tgt" 2>/dev/null; then
      rm -f "$ax_target"
      if [ "$ax_idx" -eq 0 ]; then
        ax_live="head"
      else
        ax_live="near"
      fi
      break
    fi
    rm -f "$ax_target"
    ax_idx=$((ax_idx + 1))
  done < <(git -C "$SRC" rev-list --all -- "$src" 2>/dev/null)

  if [ "$(guard_decide "$ax_col1" "$ax_src" "$ax_live" "$ax_ct")" = "BLOCK" ]; then
    behind+=("$tgt")
  fi
done < <(chezmoi status)

# bash 3.2 renders an empty array as one empty word under `set -u`, so the count gets
# checked before anything expands it. Same hazard the claude-plugins installer documents.
if [ "${#behind[@]}" -gt 0 ]; then
  echo "    ! these files have source commits this machine never applied:"
  for tgt in "${behind[@]}"; do
    echo "        $tgt"
  done
  # "Nothing was captured" is scoped to the re-add. The VS Code list and the plugin
  # manifests above have already written into $SRC by this point, but the exit below comes
  # before the commit phase, so none of it lands in git.
  echo "    Capturing now would revert them. Nothing was captured."
  echo ""
  first="${behind[0]}"
  echo "    See what would change:       chezmoi diff ~/$first"
  echo "    Take source's version:       chezmoi apply ~/$first"
  # Not optional: an mtime clobbered by a restore or a file-sync tool would otherwise make
  # this guard inescapable, leaving the user no move but to edit the script.
  echo "    Keep this machine's version: chezmoi re-add ~/$first"
  echo "    Then re-run:                 dotfiles-sync"
  notify_fail "Source is ahead of this machine. Nothing captured. See $LOG."
  exit 1
fi
echo "    none"

# ---- Phase: chezmoi re-add ----
echo "==> Capturing live \$HOME changes back into source"
if ! chezmoi re-add 2>&1; then
  notify_fail "chezmoi re-add hit an error. Check $LOG for what broke."
  exit 1
fi

# ---- Phase: strip machine-local keys the re-add just pulled in ----
# The blanket re-add above can't tell a shared setting from a machine-local one, and
# /model writes its choice straight into settings.json. Undo that here rather than
# before the re-add: stripping the live file instead would wipe the pin on every sync.
echo "==> Normalizing Claude settings"
if command -v claude-settings-normalize &>/dev/null; then
  claude-settings-normalize || echo "    ! settings normalize failed, continuing"
else
  echo "    claude-settings-normalize not found, skipping"
fi

# ---- Phase: template drift (what re-add structurally can't capture) ----
# re-add won't reverse-render a template, so a templated file an app rewrites in
# $HOME slips past the capture above. Warn so it doesn't rot unnoticed.
echo "==> Checking for drifted templates re-add couldn't capture"
tmpl_drift=0
while IFS= read -r line; do
  # Column 0, not column 1. Column 1 is the apply direction; this phase asks what the
  # re-add couldn't capture, and re-add's direction is column 0. Reading column 1 here
  # reported an unapplied source edit as uncaptured live drift, the same confusion the
  # preflight guard above exists to resolve.
  [[ "${line:0:1}" == "M" || "${line:0:1}" == "D" ]] || continue
  tgt="${line:3}"
  src="$(chezmoi source-path "$HOME/$tgt" 2>/dev/null)" || continue
  if [[ "$src" == *.tmpl ]]; then
    echo "    ! $tgt drifted but is a template — not captured; reconcile by hand"
    tmpl_drift=1
  fi
done < <(chezmoi status)
if [[ "$tmpl_drift" -eq 1 ]]; then
  notify "Dotfiles: template drift" "A templated file drifted and wasn't captured. See $LOG."
else
  echo "    none"
fi

# ---- Phase: package drift report (read-only; never edits) ----
echo "==> Package drift (installed but untracked; file it into a bundle if you want it kept)"
if command -v brew &>/dev/null && command -v jq &>/dev/null; then
  # Mirrors dotfiles-doctor's Homebrew section: same registry, same enabled-bundle filter,
  # same two spellings for tapped formulae. This one only reports the untracked direction,
  # since a package the registry wants but hasn't installed isn't something to capture.
  bundles="$(chezmoi execute-template '{{ template "bundles" . }}')"
  pkgs="$(chezmoi execute-template '{{ .pkg.packages | toJson }}')"
  tracked_brew="$(jq -r --argjson b "$bundles" '
    .[] | select(.type == "brew") | select(.bundles | any(IN($b[])))
    | .name, (.name | split("/") | last)' <<<"$pkgs")"
  tracked_cask="$(jq -r --argjson b "$bundles" '
    .[] | select(.type == "cask") | select(.bundles | any(IN($b[]))) | .name' <<<"$pkgs")"
  drift=0
  while IFS= read -r formula; do
    grep -qxF "$formula" <<<"$tracked_brew" || { echo "    + brew  $formula"; drift=1; }
  done < <(brew leaves)
  while IFS= read -r cask; do
    grep -qxF "$cask" <<<"$tracked_cask" || { echo "    + cask  $cask"; drift=1; }
  done < <(brew list --cask 2>/dev/null)
  [[ "$drift" -eq 0 ]] && echo "    none, the registry matches what's installed"
else
  echo "    brew or jq not found, skipping"
fi

# ---- Phase: commit + push ----
cd "$SRC"

# 2026-06-26 through 08-06: an abandoned interactive rebase left this source
# dir detached, and every run after committed onto it anyway, reporting
# success while push and `chezmoi update` both stayed dead for six weeks.
# Refuse before the clean-tree check below — a detached HEAD with nothing
# to commit still blocks `chezmoi update`, which was half the incident's
# cost. Operation markers are checked before HEAD: a stopped rebase is also
# a detached HEAD, and reporting it as one hands the user a `git checkout`
# that git will refuse.
if [ -d "$SRC/.git/rebase-merge" ] || [ -d "$SRC/.git/rebase-apply" ]; then
  notify_fail "Rebase in progress in $SRC. Run 'rebase --continue' or 'rebase --abort'."
  echo "==> Refusing to commit: rebase in progress. Run 'git -C \"$SRC\" rebase --continue' once conflicts are resolved, or 'git -C \"$SRC\" rebase --abort' to cancel it."
  exit 1
elif [ -f "$SRC/.git/MERGE_HEAD" ]; then
  notify_fail "Merge in progress in $SRC. Run 'git commit' or 'git merge --abort'."
  echo "==> Refusing to commit: merge in progress. Run 'git -C \"$SRC\" commit' once conflicts are resolved, or 'git -C \"$SRC\" merge --abort' to cancel it."
  exit 1
elif ! git symbolic-ref -q HEAD >/dev/null; then
  head_sha="$(git rev-parse --short HEAD)"
  notify_fail "HEAD is detached in $SRC at $head_sha. Run 'git switch -c' to reattach."
  echo "==> Refusing to commit: HEAD is detached at $head_sha. Run 'git -C \"$SRC\" switch -c recovered-$head_sha' to reattach without losing the commit."
  exit 1
fi

if [[ -z "$(git status --porcelain)" ]]; then
  echo "==> Nothing to commit. Already in sync."
  exit 0
fi

file_count="$(git status --porcelain | wc -l | tr -d ' ')"
files_word="file"
[[ "$file_count" != "1" ]] && files_word="files"

echo "==> Committing $file_count $files_word"
git add -A

commit_msg="[auto-sync from ${HOST}] $(date -u +%Y-%m-%d) - ${file_count} ${files_word}"
if ! git commit -m "$commit_msg" 2>&1; then
  # The commit hook stuff lives in $LOG via the exec redirect above.
  if grep -qi "pre-commit\|husky" "$LOG"; then
    notify_fail "Pre-commit hook blocked the auto-sync. See $LOG for the hook's complaint."
  else
    notify_fail "git commit failed. See $LOG."
  fi
  exit 1
fi

# Push is opt-in. Under launchd the 1Password SSH agent isn't reachable, so an
# unattended push just fails and buries the error in the log — and for dotfiles
# you want a push-protection block to be seen, not hidden (an npm token got caught
# exactly this way). So commit locally and push by hand. Set DOTFILES_AUTO_PUSH=1
# (e.g. in the plist's EnvironmentVariables) on a machine with non-agent auth
# wired up to turn automatic pushes back on.
if [[ "${DOTFILES_AUTO_PUSH:-0}" != "1" ]]; then
  notify "Dotfiles committed" "Captured ${file_count} ${files_word} from ${HOST}. Push by hand when ready."
  echo "==> Committed locally. Auto-push is off; push manually:  git -C \"$SRC\" push"
  exit 0
fi

echo "==> Pushing to origin"
if ! git push 2>&1; then
  # Classify push failure from the tail of the log.
  err="$(tail -20 "$LOG")"
  if echo "$err" | grep -qiE "could not resolve host|network is unreachable|operation timed out|getaddrinfo|temporary failure"; then
    notify_fail "Push failed: network is down. Run dotfiles-sync once you're back online."
  elif echo "$err" | grep -qiE "permission denied \(publickey\)|authentication failed|invalid credentials|key.*denied"; then
    notify_fail "Push refused: SSH auth failed. 1Password agent might be locked. Unlock it and re-run dotfiles-sync."
  elif echo "$err" | grep -qiE "rejected.*non-fast-forward|fetch first|tip of your current branch is behind"; then
    notify_fail "Push rejected: remote has commits you don't. Run 'chezmoi update', then dotfiles-sync."
  else
    notify_fail "Push failed. See $LOG for the git error."
  fi
  exit 1
fi

notify "Dotfiles synced" "Captured ${file_count} ${files_word} from ${HOST}."
echo "==> Done. Other machines can pull with \`chezmoi update\`."
