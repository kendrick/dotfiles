#!/bin/bash
# dotfiles-teardown — strip this setup off a machine you're handing back.
#
# Dry run by default. Nothing is removed until you pass --yes, and the dry run prints the
# exact resolved paths, so what you approve is what runs.
#
# Two levels. The default takes secrets only: the encrypted targets, the age key, the
# credentials the run_ scripts create, and the local machine config. --full also takes the
# managed dotfiles, the auto-sync agent, and the source repo. Neither touches apps.
#
# --full refuses to run while the source repo has uncommitted or unpushed work, since it
# purges the repo and that work would be gone for good (--force-dirty overrides). It also
# asks you to type the hostname, rather than accepting a reflexive y.
#
# Every run that removes something writes a receipt of the paths it took. Check it later
# with --verify, which is the only way to audit a --full run: by then chezmoi is gone and
# the list can't be rebuilt.
#
# The sensitive set is derived, not remembered. Encrypted targets come from `chezmoi
# managed --include=encrypted`, so an encrypted file added to the repo next year is
# covered here with no edit. What chezmoi can't see (the gh token, the SSO cache) is
# declared by the script that creates it, as `# teardown:<class> <path>`. dotfiles-doctor
# flags any run_ script that declares nothing, which is what keeps this honest.
#
# teardown:none

set -uo pipefail

{{ template "sh-ui.sh" . }}

trap show_cursor EXIT

LABEL="com.k-arnett.dotfiles-auto-sync"
PLIST="{{ .chezmoi.homeDir }}/Library/LaunchAgents/${LABEL}.plist"
DEPLOY_KEY="{{ .chezmoi.homeDir }}/.ssh/quantified_claude_events_deploy"

FULL=0
COMMIT=0
FORCE_DIRTY=0
VERIFY=""
RECEIPT=""

# Parsing shifts these away, and the re-exec below needs to hand the child the same flags.
# Without this the child relaunches bare and silently downgrades --full --yes to a dry run.
ORIG_ARGC=$#
ORIG_ARGS=()
[ "$ORIG_ARGC" -gt 0 ] && ORIG_ARGS=("$@")

while [ "$#" -gt 0 ]; do
  case "$1" in
    --full) FULL=1 ;;
    --yes | -y) COMMIT=1 ;;
    --force-dirty) FORCE_DIRTY=1 ;;
    --verify)
      VERIFY="${2:-}"
      [ -n "$VERIFY" ] || {
        warn "--verify needs a receipt file."
        exit 2
      }
      shift
      ;;
    --receipt)
      RECEIPT="${2:-}"
      [ -n "$RECEIPT" ] || {
        warn "--receipt needs a path."
        exit 2
      }
      shift
      ;;
    -h | --help)
      # Print the header block: line 2 through the first blank line. Keyed off the file's
      # shape rather than a line number, so editing the header can't silently truncate
      # help or leak the teardown declaration into it.
      sed -n '2,/^$/p' "$0" | grep -v '^# teardown:' | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      warn "Unknown option: $1"
      say "Usage: dotfiles-teardown [--full] [--yes] [--force-dirty] [--receipt PATH]"
      say "       dotfiles-teardown --verify RECEIPT"
      exit 2
      ;;
  esac
  shift
done

# Re-check each path in a receipt. Read-only, so it runs ahead of the re-exec below.
if [ -n "$VERIFY" ]; then
  [ -r "$VERIFY" ] || {
    warn "Can't read receipt: $VERIFY"
    exit 2
  }
  total=0
  remaining=0
  while IFS= read -r p; do
    case "$p" in '' | '#'*) continue ;; esac
    total=$((total + 1))
    if [ -e "$p" ]; then
      warn "still present: $p"
      remaining=$((remaining + 1))
    fi
  done <"$VERIFY"
  printf '\n'
  if [ "$remaining" -eq 0 ]; then
    ok "$total of $total paths confirmed gone."
    exit 0
  fi
  warn "$remaining of $total paths are still on this machine."
  exit 1
fi

# This script is itself a managed file that --full deletes. bash reads a script
# incrementally, so deleting it out from under a running shell truncates whatever hasn't
# been parsed yet. Re-exec from a copy the teardown will never touch.
if [ -z "${DOTFILES_TEARDOWN_REEXEC:-}" ]; then
  tmp=$(mktemp "${TMPDIR:-/tmp}/dotfiles-teardown.XXXXXX") || exit 1
  cat "$0" >"$tmp" && chmod +x "$tmp" || exit 1
  if [ "$ORIG_ARGC" -gt 0 ]; then
    DOTFILES_TEARDOWN_REEXEC=1 "$tmp" "${ORIG_ARGS[@]}"
  else
    DOTFILES_TEARDOWN_REEXEC=1 "$tmp"
  fi
  rc=$?
  rm -f "$tmp"
  exit $rc
fi

# --- discovery -------------------------------------------------------------------
# Everything is enumerated up front, while chezmoi and the source tree still exist. The
# purge at the end destroys the very thing these calls read.

SRC=$(chezmoi source-path 2>/dev/null) || SRC=""

secrets=()
data=()

# The same path can legitimately arrive twice: the age key is both declared by the script
# that writes it and part of the fixed chezmoi state below. No associative arrays here,
# since /bin/bash on macOS is still 3.2.
already_listed() { # path
  local p
  for p in "${secrets[@]:-}" "${data[@]:-}"; do
    [ "$p" = "$1" ] && return 0
  done
  return 1
}

add_path() { # class, path
  local expanded=${2/#\~/$HOME}
  [ -e "$expanded" ] || return 0
  already_listed "$expanded" && return 0
  case "$1" in
    secret) secrets+=("$expanded") ;;
    data) data+=("$expanded") ;;
  esac
}

# Encrypted managed targets, straight from chezmoi. This is the part that stays correct
# as the repo grows.
if command -v chezmoi >/dev/null 2>&1; then
  while IFS= read -r rel; do
    [ -n "$rel" ] && add_path secret "$HOME/$rel"
  done < <(chezmoi managed --include=encrypted 2>/dev/null)
fi

# Declared side effects. -I skips the binaries that live in dot_local/bin.
if [ -n "$SRC" ]; then
  while read -r class path; do
    case "$class" in
      secret | data) add_path "$class" "$path" ;;
      none) ;;
      *)
        warn "Unknown teardown class '$class' (path: ${path:-none}). Fix the declaration."
        exit 1
        ;;
    esac
  done < <(grep -hI '^# teardown:' "$SRC"/run_* "$SRC"/dot_local/bin/* 2>/dev/null |
    sed 's/^# teardown://' | awk '{print $1, $2}')
fi

# Machine-local chezmoi state, plus the per-machine deploy key. Fixed infrastructure: not
# derivable, but it doesn't move. The deploy key belongs in the enumerated list rather
# than being deleted quietly at the end, so the dry run shows everything that will go.
for p in "$HOME/.config/chezmoi/key.txt" \
  "$HOME/.config/chezmoi/chezmoi.toml" \
  "$HOME/.config/chezmoi/chezmoistate.boltdb" \
  "$DEPLOY_KEY" "${DEPLOY_KEY}.pub"; do
  add_path secret "$p"
done

# --- plan ------------------------------------------------------------------------

printf '\n'
if [ "$COMMIT" -eq 1 ]; then
  say "Teardown, level $([ "$FULL" -eq 1 ] && echo full || echo secrets). This will remove:"
else
  say "Dry run, level $([ "$FULL" -eq 1 ] && echo full || echo secrets). Would remove:"
fi
printf '\n'

if [ "${#secrets[@]}" -eq 0 ]; then
  say "  (no secrets found on this machine)"
else
  for p in "${secrets[@]}"; do printf '    %s\n' "$p"; done
fi

if [ "$FULL" -eq 1 ]; then
  printf '\n'
  say "  plus, at --full:"
  # /bin/bash on macOS is 3.2, where "${arr[@]}" on an empty array aborts under set -u.
  # An empty list is the normal state of a second run, so every expansion is count-guarded.
  if [ "${#data[@]}" -gt 0 ]; then
    for p in "${data[@]}"; do printf '    %s\n' "$p"; done
  fi
  [ -e "$PLIST" ] && printf '    %s\n' "$PLIST"
  printf '    %s\n' "every file in \`chezmoi managed\` (via chezmoi destroy)"
  [ -n "$SRC" ] && printf '    %s\n' "$SRC (via chezmoi purge)"
fi

printf '\n'
say "  and will sign out of: gh, 1Password CLI"
printf '\n'

if [ "$COMMIT" -ne 1 ]; then
  say "Nothing removed. Re-run with --yes to do it."
  [ "$FULL" -ne 1 ] && say "Add --full to also take the dotfiles, the sync agent, and the repo."
  exit 0
fi

# Everything else here is recoverable: secrets come back from 1Password, dotfiles from a
# re-clone. A commit that only exists on this machine does not. --full purges the repo, so
# refuse while anything is unsaved. The auto-sync agent has a habit of committing
# work in progress, so a dirty tree at an unexpected moment is normal, not exotic.
if [ "$FULL" -eq 1 ] && [ "$FORCE_DIRTY" -ne 1 ] && [ -n "$SRC" ]; then
  dirty=$(git -C "$SRC" status --porcelain 2>/dev/null)
  unpushed=$(git -C "$SRC" log --oneline '@{u}..HEAD' 2>/dev/null)
  if [ -n "$dirty" ] || [ -n "$unpushed" ]; then
    warn "The source repo has unsaved work, and --full purges it. That would be permanent."
    printf '\n'
    [ -n "$unpushed" ] && printf '%s\n' "$unpushed" | sed 's/^/      /'
    [ -n "$dirty" ] && printf '%s\n' "$dirty" | sed 's/^/      /'
    printf '\n'
    say "Push and commit first, or re-run with --force-dirty if you mean to lose it."
    exit 1
  fi
fi

# Anything still running can put files back. The auto-sync agent runs dotfiles-sync, which
# re-adds and commits; the settings.json SessionStart hook and the zsh skills()/claude()/
# code() wrappers re-add into the source tree on ordinary use.
warn "Close other terminals and Claude sessions first: their hooks re-add files into the"
warn "source tree, and an auto-sync run mid-teardown can commit what you're removing."
printf '\n'

# --full deletes every managed dotfile and purges the repo. A reflexive `y` is too cheap a
# gate for that, so make it cost a deliberate keystroke, the way `gh repo delete` does.
if [ "$FULL" -eq 1 ]; then
  host=$(hostname -s 2>/dev/null || echo unknown)
  say "This removes every managed dotfile and purges the repo on ${host}."
  printf '  Type the hostname to confirm: '
  read -r reply || reply=""
  if [ "$reply" != "$host" ]; then
    say "Aborted. Nothing removed."
    exit 0
  fi
else
  printf '  Continue? [y/N] '
  read -r reply || reply=""
  case "$reply" in
    [yY] | [yY][eE][sS]) ;;
    *)
      say "Aborted. Nothing removed."
      exit 0
      ;;
  esac
fi
printf '\n'

# Written before anything is removed, because once the purge lands there's no chezmoi left
# to re-derive the list from, and a --full run would otherwise be unauditable. It records
# paths, never contents, and lives outside the teardown set so it survives its own run.
# Move it off the machine if you'd rather not leave a map of where the secrets were.
if [ -z "$RECEIPT" ]; then
  RECEIPT="$HOME/dotfiles-teardown-$(date +%Y%m%d-%H%M%S).txt"
fi
{
  printf '# dotfiles-teardown receipt, level %s\n' "$([ "$FULL" -eq 1 ] && echo full || echo secrets)"
  printf '# verify with: dotfiles-teardown --verify %s\n' "$RECEIPT"
  [ "${#secrets[@]}" -gt 0 ] && printf '%s\n' "${secrets[@]}"
  if [ "$FULL" -eq 1 ]; then
    [ "${#data[@]}" -gt 0 ] && printf '%s\n' "${data[@]}"
    [ -e "$PLIST" ] && printf '%s\n' "$PLIST"
    [ -n "$SRC" ] && printf '%s\n' "$SRC"
  fi
} >"$RECEIPT" 2>/dev/null && ok "Receipt: $RECEIPT"
printf '\n'

# --- execution -------------------------------------------------------------------
# Order matters. The sync agent goes first so it can't race the removals, and the purge
# goes last because it destroys the source tree everything else reads.

if launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null; then
  ok "Stopped the auto-sync agent."
else
  say "Auto-sync agent wasn't loaded."
fi

remove_path() {
  if rm -rf "$1"; then
    ok "Removed $1"
  else
    warn "Couldn't remove $1"
  fi
}

if [ "${#secrets[@]}" -gt 0 ]; then
  for p in "${secrets[@]}"; do remove_path "$p"; done
fi

if command -v gh >/dev/null 2>&1; then
  if gh auth logout --hostname github.com >/dev/null 2>&1; then
    ok "Signed out of gh."
  else
    say "gh wasn't signed in."
  fi
fi
if command -v op >/dev/null 2>&1; then
  if op signout --all >/dev/null 2>&1; then
    ok "Signed out of the 1Password CLI."
  else
    say "1Password CLI wasn't signed in."
  fi
fi

if [ "$FULL" -eq 1 ]; then
  if [ "${#data[@]}" -gt 0 ]; then
    for p in "${data[@]}"; do remove_path "$p"; done
  fi
  if [ -e "$PLIST" ]; then
    remove_path "$PLIST"
  fi

  # Take the deployed dotfiles before the source tree goes; destroy needs both.
  destroy_failed=0
  while IFS= read -r abs; do
    [ -n "$abs" ] || continue
    chezmoi destroy --force "$abs" >/dev/null 2>&1 || destroy_failed=1
  done < <(chezmoi managed --include=files --path-style=absolute 2>/dev/null)

  if [ "$destroy_failed" -eq 1 ]; then
    warn "Some managed files wouldn't delete, so the source repo is being left in place."
    warn "Look at what's left with 'chezmoi managed', then run 'chezmoi purge --force'."
  else
    ok "Removed the managed dotfiles."
    if chezmoi purge --force >/dev/null 2>&1; then
      ok "Purged the source repo and chezmoi config."
    else
      warn "Purge failed. Remove $SRC and ~/.config/chezmoi by hand."
    fi
  fi
fi

# --- what this can't do ----------------------------------------------------------

printf '\n'
warn "The quantified-claude deploy key is gone from disk but still live on GitHub."
warn "Deleting the local copy revokes nothing:"
say "    gh repo deploy-key list <owner/repo>"
say "    gh repo deploy-key delete <owner/repo> <id>"
printf '\n'
say "Still on this machine, deliberately: Homebrew and every app it installed, the macOS"
say "defaults, ~/.nvm and the global node packages, and anything in the login keychain."
printf '\n'
