#!/usr/bin/env bash
#
# Switch the coding font across Ghostty and VS Code together, then hand both
# files back to chezmoi so the change survives the next apply.
#
# Neither config is a chezmoi template, and neither should become one:
# `chezmoi re-add` skips templates, so converting either would silently drop it
# from `dotfiles-sync` capture. That's the same failure the README documents for
# the Brewfile. Both stay plain-managed and this script mutates them in place.
#
# Every family name lives in the registry. If you find one spelled out below,
# something has gone wrong.

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
REGISTRY="$CONFIG_HOME/font/registry.json"
JSONC="$CONFIG_HOME/font/jsonc.jq"
GHOSTTY="$CONFIG_HOME/ghostty/config"
VSCODE="$HOME/Library/Application Support/Code/User/settings.json"

# What the registry lists and what this machine has installed are two different
# questions. The second one is answered from a cache because `system_profiler
# SPFontsDataType` takes about ten seconds, which nobody should pay per switch.
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
FAMILY_CACHE="$CACHE_HOME/font/families"

# Fonts get installed rarely enough that a week-old answer is usually still
# right, and --refresh and --force cover the times it isn't.
CACHE_MAX_AGE_SECONDS=$((7 * 24 * 60 * 60))

BEGIN_MARKER='# BEGIN font (managed by `font`)'
END_MARKER='# END font'

# The VS Code keys this script owns. Anything not listed here it must not touch.
# `editor.fontSize` is deliberately absent: it's set to a different value than
# the terminal on purpose, and the size argument is about terminal legibility.
EDITOR_FAMILY_KEY='editor.fontFamily'
EDITOR_LIGATURES_KEY='editor.fontLigatures'
EDITOR_VARIATIONS_KEY='editor.fontVariations'
# VS Code's terminal takes the patched static while the editor keeps the variable
# build, so this key deliberately disagrees with editor.fontFamily above. The
# patcher destroys variable axes, which makes that an either/or rather than a
# preference; decisionLog has the long version.
TERMINAL_FAMILY_KEY='terminal.integrated.fontFamily'
TERMINAL_SIZE_KEY='terminal.integrated.fontSize'
# VS Code's integrated terminal has its own ligature switch, separate from the
# editor's and off by default, so a font can ligate in the editor and not one
# pane over. Its featureSettings also defaults to 'calt', which does nothing for
# the roster entries that implement ligatures under liga and dlig instead, so
# both keys get driven from the registry rather than left at their defaults.
TERMINAL_LIGATURES_KEY='terminal.integrated.fontLigatures.enabled'
TERMINAL_FEATURES_KEY='terminal.integrated.fontLigatures.featureSettings'

die() {
	echo "font: $*" >&2
	exit 1
}

# Both configs are rewritten by building a temp file and moving it into place,
# which is what keeps a failed run from leaving a half-written config. The catch
# is that mktemp creates 0600, so a bare `mv` quietly tightens the target's mode.
# chezmoi notices, re-adds the file as a `private_` source entry, and one edit
# turns into a delete plus an add that renames the file in the source tree.
replace_preserving_mode() {
	local tmp=$1 target=$2 mode
	mode=$(stat -f '%Lp' "$target" 2>/dev/null || echo 644)
	mv "$tmp" "$target"
	chmod "$mode" "$target"
}

require_deps() {
	command -v jq >/dev/null 2>&1 || die "jq is not installed; it is declared in the Brewfile"
	[ -f "$REGISTRY" ] || die "registry not found at $REGISTRY"
	[ -f "$JSONC" ] || die "JSONC filter not found at $JSONC"
}

# The ten-second system_profiler pipeline, alone, so cmd_add can run it twice
# (before/after a cask install) without going through the cache-file dance that
# rebuild_family_cache wraps around it.
snapshot_families() {
	command -v system_profiler >/dev/null 2>&1 ||
		die "system_profiler is not on PATH, so there is no way to tell what is installed"

	system_profiler SPFontsDataType 2>/dev/null |
		sed -n 's/^[[:space:]]*Family: //p' | sort -u
}

rebuild_family_cache() {
	local tmp
	mkdir -p "$(dirname "$FAMILY_CACHE")"
	tmp=$(mktemp)
	snapshot_families >"$tmp" || true

	# An empty answer is indistinguishable from a machine with no fonts on it, and
	# caching it would make every font in the registry look absent from here on.
	# The old cache, however stale, is a better guess than that.
	[ -s "$tmp" ] || {
		rm -f "$tmp"
		die "system_profiler reported no font families; leaving the existing cache alone rather than caching a list that would refuse everything"
	}

	replace_preserving_mode "$tmp" "$FAMILY_CACHE"
	# On stderr because it explains a ten-second pause rather than answering the
	# question that was asked, and because the roster listing has to stay parseable.
	echo "font: cached $(wc -l <"$FAMILY_CACHE" | tr -d ' ') installed families" >&2
}

ensure_family_cache() {
	local mtime age

	if [ ! -s "$FAMILY_CACHE" ]; then
		rebuild_family_cache
		return
	fi

	mtime=$(stat -f '%m' "$FAMILY_CACHE" 2>/dev/null || echo 0)
	age=$(($(date +%s) - mtime))
	[ "$age" -le "$CACHE_MAX_AGE_SECONDS" ] || rebuild_family_cache
}

# Runs before either config is touched, which is the only ordering that helps.
# Name a family macOS can't resolve and it substitutes without a word: the config
# stays valid, the apply succeeds, nothing exits non-zero, and the first sign of
# trouble is a terminal full of replacement boxes. A refusal is the only outcome
# that names what went wrong while there's still something to do about it.
check_available() {
	local entry=$1 key=$2
	local family tier label hint

	family=$(jq -r '.terminal.family' <<<"$entry")
	tier=$(jq -r '.tier' <<<"$entry")
	label=$(jq -r '.label' <<<"$entry")

	ensure_family_cache
	if grep -qxF "$family" "$FAMILY_CACHE"; then
		return 0
	fi

	case $tier in
	c) hint="Tier C fonts are fetched from 1Password and patched locally, so either the fetch script has not run or the item is not in the vault yet." ;;
	*) hint="Tier A and B fonts install from the Brewfile, so \`brew bundle\` is the likely gap." ;;
	esac

	die "$label (tier $tier) is not installed: no font family named \"$family\" in $FAMILY_CACHE.
  $hint
  If you installed it after the cache was built, run \`font --refresh\`, or \`font $key --force\` to write anyway."
}

# Reads the VS Code settings through the JSONC filter. Trailing commas are
# tolerated because Prettier owns them; comments fail here on purpose, and the
# caller is expected to stop rather than rewrite the file without them.
read_settings() {
	[ -f "$VSCODE" ] || die "VS Code settings not found at $VSCODE"
	jq -Rs -f "$JSONC" "$VSCODE" 2>/dev/null ||
		die "cannot parse $VSCODE; if it has comments, remove them by hand rather than letting this script strip them"
}

current_terminal_family() {
	awk -v b="$BEGIN_MARKER" -v e="$END_MARKER" '
		$0 == b { inside = 1; next }
		$0 == e { inside = 0; next }
		inside && /^font-family = / {
			sub(/^font-family = "/, ""); sub(/"$/, ""); print; exit
		}
	' "$GHOSTTY"
}

cmd_list() {
	local active
	ensure_family_cache
	active=$(current_terminal_family)
	# Every entry shows regardless of what's installed. Hiding absent ones would
	# make a machine that simply hasn't fetched them look like a broken registry.
	# So listing reports availability where switching enforces it.
	jq -r --arg active "$active" --rawfile families "$FAMILY_CACHE" '
		($families | split("\n")) as $installed
		| to_entries
		| sort_by(.value.order)
		| .[]
		| .value.terminal.family as $family
		| (if $family == $active then "* " else "  " end)
			+ .key + "  " + .value.label
			+ (if ($installed | index($family)) then "" else "  (not installed)" end)
	' "$REGISTRY"
	echo
	echo "active terminal family: ${active:-none}"
}

write_ghostty() {
	local family=$1 size=$2 features=$3 fallback=$4 tmp
	local begin_line end_line

	begin_line=$(grep -nxF "$BEGIN_MARKER" "$GHOSTTY" | head -1 | cut -d: -f1 || true)
	end_line=$(grep -nxF "$END_MARKER" "$GHOSTTY" | head -1 | cut -d: -f1 || true)

	[ -n "$begin_line" ] || die "$GHOSTTY has no '$BEGIN_MARKER' line; refusing to guess where the font block belongs"
	[ -n "$end_line" ] || die "$GHOSTTY has no '$END_MARKER' line; refusing to guess where the font block ends"
	[ "$end_line" -gt "$begin_line" ] || die "$GHOSTTY has its font markers out of order"

	tmp=$(mktemp)
	{
		head -n "$begin_line" "$GHOSTTY"
		echo "font-family = \"$family\""
		# Repeating font-family appends a fallback for codepoints the primary
		# lacks, which is how an unpatched font gets its icons without being
		# patched. Empty for the patched families, which carry their own.
		[ -n "$fallback" ] && echo "font-family = \"$fallback\""
		echo "font-size = $size"
		local feature
		# Ghostty takes one font-feature per line rather than a list.
		while IFS= read -r feature; do
			[ -n "$feature" ] && echo "font-feature = $feature"
		done <<<"${features//,/$'\n'}"
		tail -n "+$end_line" "$GHOSTTY"
	} >"$tmp"
	replace_preserving_mode "$tmp" "$GHOSTTY"
}

# Rewrites one key's value in place, leaving every other byte alone. The whole
# object is never serialized back out: jq emits strict JSON, which would strip
# the trailing commas that format-on-save then restores, churning this file on
# every switch.
write_vscode_key() {
	local key=$1 value=$2 escaped matches tmp
	escaped=${key//./\\.}

	matches=$(grep -cE "^[[:space:]]*\"$escaped\"[[:space:]]*:" "$VSCODE" || true)
	[ "$matches" -eq 1 ] ||
		die "expected exactly one \"$key\" line in $VSCODE, found $matches; refusing to write a partial config"

	tmp=$(mktemp)
	awk -v key="$key" -v value="$value" '
		BEGIN { pattern = "^[[:space:]]*\"" key "\"[[:space:]]*:"; gsub(/\./, "\\.", pattern) }
		$0 ~ pattern {
			match($0, /^[[:space:]]*/)
			indent = substr($0, 1, RLENGTH)
			comma = ($0 ~ /,[[:space:]]*$/) ? "," : ""
			print indent "\"" key "\": " value comma
			next
		}
		{ print }
	' "$VSCODE" >"$tmp"
	replace_preserving_mode "$tmp" "$VSCODE"
}

cmd_switch() {
	local key=$1 size_override=$2 force=$3
	local entry size family features fallback editor_family ligatures variations terminal_family

	entry=$(jq -e --arg k "$key" '.[$k] // empty' "$REGISTRY") ||
		die "unknown font '$key'; run 'font' with no arguments to see the roster"

	# Everything is read and validated before anything is written, so a failure
	# halfway through can't leave the two configs disagreeing.
	read_settings >/dev/null
	[ -f "$GHOSTTY" ] || die "Ghostty config not found at $GHOSTTY"
	[ "$force" -eq 1 ] || check_available "$entry" "$key"

	size=${size_override:-$(jq -r '.size' <<<"$entry")}
	[[ "$size" =~ ^[0-9]+$ ]] || die "size must be a positive integer, got '$size'"

	family=$(jq -r '.terminal.family' <<<"$entry")
	features=$(jq -r '.terminal.features' <<<"$entry")
	# Absent on every patched family, so `// ""` rather than a required field.
	fallback=$(jq -r '.terminal.fallback // ""' <<<"$entry")
	editor_family=$(jq -r '.editor.family' <<<"$entry")
	ligatures=$(jq -r '.editor.ligatures' <<<"$entry")
	variations=$(jq -r '.editor.variations' <<<"$entry")
	terminal_family=$(jq -r '.editor.terminalFamily' <<<"$entry")

	write_ghostty "$family" "$size" "$features" "$fallback"
	write_vscode_key "$EDITOR_FAMILY_KEY" "$(jq -n --arg v "$editor_family" '$v')"
	write_vscode_key "$EDITOR_LIGATURES_KEY" "$(jq -n --arg v "$ligatures" '$v')"
	write_vscode_key "$EDITOR_VARIATIONS_KEY" "$(jq -n --arg v "$variations" '$v')"
	write_vscode_key "$TERMINAL_FAMILY_KEY" "$(jq -n --arg v "$terminal_family" '$v')"
	write_vscode_key "$TERMINAL_LIGATURES_KEY" true
	write_vscode_key "$TERMINAL_FEATURES_KEY" "$(jq -n --arg v "$ligatures" '$v')"
	write_vscode_key "$TERMINAL_SIZE_KEY" "$size"

	# Without the re-add, the next `chezmoi apply` reverts both files.
	chezmoi re-add "$GHOSTTY" "$VSCODE"

	echo "font: switched to $(jq -r '.label' <<<"$entry") at ${size}pt"
}

# ---- --add / --remove ----
#
# Both write into the chezmoi *source* tree rather than $HOME, which is the
# opposite direction from write_ghostty/write_vscode_key above and follows
# dotfiles-apps instead: a repo edit that every machine picks up on its next
# pull, not a local one. Same anchored-write discipline as the rest of this
# file — mktemp, edit, replace_preserving_mode — because jq round-tripping
# either target file is destructive (verified: it explodes a single-line
# `"casks": ["x"]` onto four lines) and both files carry hand alignment or
# comments a reserialize would flatten.

# The registry closes with exactly one line that is `}` alone — every nested
# closer carries a leading tab. That makes it a single, unambiguous splice
# point for both the last entry's comma (on --add) and the file's own end
# (on --remove, once the removed entry was the last one). More than one such
# line, or none, means the registry is not shaped the way every other write
# in this file assumes, so it's cheaper to refuse than to guess.
registry_final_brace_line() {
	local file=$1
	awk '$0 == "}" { n++; l = NR } END { if (n == 1) print l; else exit 1 }' "$file"
}

# The insertion point for a new package: the last line still in the fonts
# group. Found by literal substring, like set_package_bundles in
# dotfiles-apps, because package names carry '/', '@', and '.' that would
# have to be escaped for a regex and are one typo away from matching the
# wrong line instead.
toml_fonts_group_anchor_line() {
	local file=$1
	awk 'index($0, "bundles = [\"fonts\"] },") { l = NR } END { if (l) print l; else exit 1 }' "$file"
}

# Prints "start end" (1-indexed, inclusive) for one registry entry, tracked
# by brace depth rather than a fixed line count: `terminal` and `editor` each
# open and close their own object inside the entry, so counting `{`/`}` is
# the only thing that survives every entry being a different number of lines.
registry_entry_bounds() {
	local file=$1 key=$2
	awk -v key="$key" '
		BEGIN { depth = 0; start = 0 }
		$0 == "\t\"" key "\": {" && start == 0 { start = NR; depth = 1; next }
		start > 0 {
			n = gsub(/{/, "{"); m = gsub(/}/, "}")
			depth += n - m
			if (depth == 0) { print start, NR; exit }
		}
	' "$file"
}

# One or more cask names -> `["a", "b"]`, matching the registry's own
# comma-space style. Not jq -c: compact mode joins with a bare comma, which
# would make every --add entry format differently from every hand-written one
# next to it.
casks_array() {
	local out="" c
	for c in "$@"; do
		out="${out:+$out, }\"$c\""
	done
	printf '[%s]' "$out"
}

# `font-caskaydia-cove-nerd-font` -> `caskaydia-cove`. Existing keys don't
# all follow this (`victor` is `font-victor-mono-nerd-font`), because they
# were chosen by hand; this is just a starting guess `--key` can override.
derive_key() {
	local key=$1
	key=${key#font-}
	key=${key%-nerd-font}
	key=${key%-nf}
	printf '%s\n' "$key"
}

# Names all three ligature signals and what each returned, pass or refuse,
# because the acceptance bar for a refusal is that a person can see which
# signal failed rather than take the verdict on faith. Also prints the
# stylistic sets, unconditionally: those are read whether or not any tag was
# named on the command line, since a set has to be seen to be judged.
print_signals_report() {
	local json=$1 tags rules available families names

	families=$(jq -r '.families | join(", ")' <<<"$json")
	tags=$(jq -r '.signals.tags | join(",")' <<<"$json")
	rules=$(jq -r '.signals.ligature_subst_rules' <<<"$json")
	available=$(jq -r '.signals.glyph_names_available' <<<"$json")

	echo "font: ligature signals for $families:"
	echo "  tags: ${tags:-(none)}"
	echo "  ligature_subst_rules: $rules"
	if [ "$available" = "false" ]; then
		echo "  glyph_names: unavailable (no post v3 names, no CFF charset to fall back on)"
	else
		# Substituted in the shell, not with jq's `//`, which only fires on null
		# and false: joining an empty array yields "", so the placeholder never
		# appeared and a refusal printed a bare label with nothing after it.
		names=$(jq -r '.signals.glyph_names | join(",")' <<<"$json")
		echo "  glyph_names: ${names:-(none)}"
	fi
	echo "  coverage: $(jq -r '"\(.coverage.present)/\(.coverage.probed) codepoints" + (if .coverage.full then " (full)" else " (partial)" end)' <<<"$json")"

	echo "font: stylistic sets (never enabled without --set):"
	jq -r '.stylistic_sets[]? | "  \(.tag): \(.name // "(no name)")"' <<<"$json"
}

# The dotfiles-apps shape: unified, context-free, one line per changed byte
# range, so a reviewer sees exactly what moved rather than a full-file dump.
show_diff() {
	local target=$1 dir
	dir=$(dirname "$target")
	echo
	if git -C "$dir" rev-parse --git-dir &>/dev/null; then
		# `|| true`: an unchanged file is a legal outcome here (not expected on
		# --add/--remove, but true of the general shape), and an empty diff
		# would otherwise exit 1 under pipefail.
		git -C "$dir" --no-pager diff --unified=0 -- "$target" \
			| { grep -E '^[-+][^-+]' || true; } | sed 's/^/  /'
	else
		echo "  (not a git repo, no diff to show)"
	fi
}

cmd_add() {
	local cask=$1 family_choice=$2 key_override=$3 sets=$4
	local src registry toml chosen_key
	local before after new_families family_count chosen
	local suggest_json rc verdict
	local terminal_features terminal_fallback editor_family editor_variations
	local editor_ligatures editor_terminal_family symbols_cask
	local order tier label size_val fallback_line terminal_casks editor_casks
	local entry_block registry_tmp final_line last_close toml_line toml_tmp
	local anchor_line type_col prefix pad_len

	command -v brew >/dev/null 2>&1 || die "brew is not installed"
	command -v font-inspect >/dev/null 2>&1 ||
		die "font-inspect is not on PATH; it ships alongside this script"

	src=$(chezmoi source-path) || die "chezmoi source-path failed"
	registry="$src/dot_config/font/registry.json"
	toml="$src/.chezmoidata.toml"
	[ -f "$registry" ] || die "registry not found at $registry"
	[ -f "$toml" ] || die "package registry not found at $toml"

	# ---- step 1: refuse cheaply, before anything is installed ----
	brew info --cask "$cask" >/dev/null 2>&1 ||
		die "'$cask' is not a known cask (checked with 'brew info --cask')"
	brew list --cask "$cask" >/dev/null 2>&1 &&
		die "'$cask' is already installed; the before/after family diff needs a clean starting point, so remove it first if you want to re-add it"

	jq -e --arg c "$cask" '
		to_entries[] | select(((.value.terminal.casks // []) + (.value.editor.casks // [])) | index($c))
	' "$registry" >/dev/null &&
		die "'$cask' is already declared in the registry"

	if [ -n "$key_override" ]; then
		chosen_key=$key_override
	else
		chosen_key=$(derive_key "$cask")
	fi
	jq -e --arg k "$chosen_key" 'has($k)' "$registry" >/dev/null &&
		die "registry key '$chosen_key' already exists; pass --key to choose a different one"

	# ---- step 2: preflight every writer, so a refusal never follows an install ----
	final_line=$(registry_final_brace_line "$registry") ||
		die "$registry has no single unambiguous closing '}' to anchor a write on"
	anchor_line=$(toml_fonts_group_anchor_line "$toml") ||
		die "$toml has no 'bundles = [\"fonts\"]' line to anchor a write after"

	# ---- step 3: the family diff ----
	before=$(mktemp)
	after=$(mktemp)
	snapshot_families >"$before" || true

	# An empty before-snapshot would make every family on the machine look new,
	# so the diff has to refuse to run rather than hand step 4 a list of 300
	# families to choose from. Same reasoning as rebuild_family_cache's guard.
	[ -s "$before" ] || {
		rm -f "$before" "$after"
		die "system_profiler reported no font families, so there is no before-state to diff against; nothing installed"
	}

	brew install --cask "$cask" || die "brew install --cask '$cask' failed"

	snapshot_families >"$after" || true
	[ -s "$after" ] || {
		rm -f "$before" "$after"
		die "system_profiler reported no font families after installing '$cask'; leaving the cask in place because the diff cannot be trusted to say what it registered"
	}
	new_families=$(comm -13 "$before" "$after")
	rm -f "$before"

	if [ -z "$new_families" ]; then
		rm -f "$after"
		brew uninstall --cask "$cask" || echo "font: warning: could not uninstall '$cask' during cleanup" >&2
		die "installing '$cask' registered no new font families; nothing to add"
	fi

	echo "font: '$cask' registered the following new families:"
	printf '%s\n' "$new_families" | sed 's/^/  /'

	# ---- step 4: choose exactly one family ----
	family_count=$(printf '%s\n' "$new_families" | wc -l | tr -d ' ')
	if [ "$family_count" -eq 1 ]; then
		chosen=$new_families
	elif [ -n "$family_choice" ] && printf '%s\n' "$new_families" | grep -qxF "$family_choice"; then
		chosen=$family_choice
	elif [ -t 0 ]; then
		echo
		echo "font: '$cask' registered several families; choose one:"
		local i=0 line pick
		while IFS= read -r line; do
			i=$((i + 1))
			echo "  $i) $line"
		done <<<"$new_families"
		read -r -p "family> " pick
		# Anything but a plain number would reach sed as a command rather than a
		# line address, so it is rejected here and falls into the empty-choice
		# path below instead of failing with sed's own error.
		case $pick in
		'' | *[!0-9]*) chosen="" ;;
		*) chosen=$(printf '%s\n' "$new_families" | sed -n "${pick}p") ;;
		esac
		if [ -z "$chosen" ]; then
			rm -f "$after"
			brew uninstall --cask "$cask" || true
			die "no family chosen; nothing written"
		fi
	else
		# Restoring the pre-install state is what makes the suggested re-run
		# actually work: a second attempt with no cask installed sees the same
		# empty-diff refusal above instead of an empty new_families list here.
		rm -f "$after"
		brew uninstall --cask "$cask" || true
		die "'$cask' registered multiple families and there is no terminal to prompt; re-run with --family '<name>', one of: $(printf '%s' "$new_families" | tr '\n' '|' | sed 's/|$//')"
	fi

	# ---- step 5: ligature verdict ----
	suggest_json=$(font-inspect --suggest --family "$chosen") && rc=0 || rc=$?
	print_signals_report "$suggest_json"

	verdict=$(jq -r '.verdict // empty' <<<"$suggest_json")
	if [ "$rc" -eq 1 ] || [ "$verdict" = "refuse" ]; then
		rm -f "$after"
		brew uninstall --cask "$cask" || echo "font: warning: could not uninstall '$cask' during cleanup" >&2
		die "font-inspect refused '$chosen': no ligature evidence across tags, substitution rules, or glyph names (see signals above). Nothing written."
	elif [ "$rc" -ne 0 ]; then
		rm -f "$after"
		brew uninstall --cask "$cask" || true
		die "font-inspect exited $rc inspecting '$chosen'; expected 0 (pass) or 1 (refuse)"
	fi

	# ---- step 6: only --set tags reach the feature strings ----
	terminal_features=$(jq -r '.suggest.terminal.features' <<<"$suggest_json")
	terminal_fallback=$(jq -r '.suggest.terminal.fallback // empty' <<<"$suggest_json")
	editor_family=$(jq -r '.suggest.editor.family' <<<"$suggest_json")
	editor_variations=$(jq -r '.suggest.editor.variations' <<<"$suggest_json")
	editor_ligatures=$(jq -r '.suggest.editor.ligatures' <<<"$suggest_json")
	editor_terminal_family=$(jq -r '.suggest.editor.terminalFamily' <<<"$suggest_json")
	symbols_cask=$(jq -r '.suggest.symbols_cask // empty' <<<"$suggest_json")

	if [ -n "$sets" ]; then
		local set_tag
		while IFS= read -r set_tag; do
			[ -n "$set_tag" ] || continue
			terminal_features="${terminal_features:+$terminal_features,}$set_tag"
			editor_ligatures="${editor_ligatures:+$editor_ligatures, }'$set_tag'"
		done <<<"${sets//,/$'\n'}"
	fi

	# ---- step 7: the registry entry ----
	order=$(jq '([.[].order] | max) + 10' "$registry")
	case $chosen in
	*"Nerd Font"*) tier=a ;;
	*) tier=b ;;
	esac
	label=$chosen
	size_val=14

	fallback_line=""
	[ -z "$terminal_fallback" ] ||
		fallback_line=$(printf '\t\t\t"fallback": %s,\n' "$(jq -n --arg v "$terminal_fallback" '$v')")

	terminal_casks=$(casks_array "$cask")
	if [ -n "$symbols_cask" ]; then
		editor_casks=$(casks_array "$cask" "$symbols_cask")
	else
		editor_casks=$(casks_array "$cask")
	fi

	entry_block=$(
		printf '\t"%s": {\n' "$chosen_key"
		printf '\t\t"order": %s,\n' "$order"
		printf '\t\t"tier": "%s",\n' "$tier"
		printf '\t\t"label": %s,\n' "$(jq -n --arg v "$label" '$v')"
		printf '\t\t"size": %s,\n' "$size_val"
		printf '\t\t"terminal": {\n'
		printf '\t\t\t"family": %s,\n' "$(jq -n --arg v "$chosen" '$v')"
		printf '\t\t\t"features": %s,\n' "$(jq -n --arg v "$terminal_features" '$v')"
		printf '%s' "$fallback_line"
		printf '\t\t\t"casks": %s\n' "$terminal_casks"
		printf '\t\t},\n'
		printf '\t\t"editor": {\n'
		printf '\t\t\t"family": %s,\n' "$(jq -n --arg v "$editor_family" '$v')"
		printf '\t\t\t"variations": %s,\n' "$(jq -n --arg v "$editor_variations" '$v')"
		printf '\t\t\t"ligatures": %s,\n' "$(jq -n --arg v "$editor_ligatures" '$v')"
		printf '\t\t\t"terminalFamily": %s,\n' "$(jq -n --arg v "$editor_terminal_family" '$v')"
		printf '\t\t\t"casks": %s\n' "$editor_casks"
		printf '\t\t}\n'
		printf '\t}'
	)

	# Built by concatenation rather than handing the multi-line block to a
	# single awk -v: BSD awk (what ships on macOS) rejects a -v value that
	# contains a literal newline, so the splice has to happen at the shell
	# level instead of inside the script.
	last_close=$((final_line - 1))
	registry_tmp=$(mktemp)
	{
		sed -n "1,$((last_close - 1))p" "$registry"
		printf '\t},\n'
		printf '%s\n' "$entry_block"
		sed -n "${final_line},\$p" "$registry"
	} >"$registry_tmp"
	jq . "$registry_tmp" >/dev/null ||
		die "registry would not parse as JSON after adding '$chosen_key'; nothing written"

	# ---- step 8: the package entry ----
	# Inserted right after the fonts group's last line, unlike dotfiles-apps's
	# append_packages which appends at the whole array's tail: the twenty lines
	# of cask-naming prose above this group (issue #15 comment) are only useful
	# sitting next to the names they warn about, and appending at the array's
	# end would strand every future --add far away from them.
	type_col=$(awk -v l="$anchor_line" 'NR == l { print index($0, "type =") }' "$toml")
	prefix="  { name = \"$cask\","
	pad_len=$((type_col - 1 - ${#prefix}))
	[ "$pad_len" -ge 1 ] || pad_len=1
	toml_line=$(printf '%s%*stype = "cask", bundles = ["fonts"] },' "$prefix" "$pad_len" "")

	toml_tmp=$(mktemp)
	awk -v at="$anchor_line" -v line="$toml_line" 'NR == at { print; print line; next } { print }' \
		"$toml" >"$toml_tmp"

	replace_preserving_mode "$registry_tmp" "$registry"
	replace_preserving_mode "$toml_tmp" "$toml"

	# ---- step 9: deploy + cache, without a third system_profiler run ----
	chezmoi apply --force "$REGISTRY"
	mkdir -p "$(dirname "$FAMILY_CACHE")"
	replace_preserving_mode "$after" "$FAMILY_CACHE"

	# ---- step 10: diff + review ----
	echo
	echo "font: wrote registry entry '$chosen_key':"
	show_diff "$registry"
	echo
	echo "font: wrote package entry for '$cask':"
	show_diff "$toml"

	echo
	echo "REVIEW — judged, not measured:"
	echo "  label: \"$label\" — copied verbatim from the family string"
	echo "  tier: $tier — guessed from whether the family name contains \"Nerd Font\""
	local wght_default
	wght_default=$(printf '%s' "$editor_variations" | sed -n "s/^'wght' //p")
	if [ -n "$wght_default" ] && [ "$wght_default" != "400" ]; then
		echo "  variations: wght default is $wght_default, not 400 — verify this isn't a broken-looking weight rather than an intentional one"
	fi
	jq -r '.stylistic_sets[]? |
		"  stylistic set \(.tag) (\(.name // "(no name)")) is not enabled; hand-edit the registry to add it to terminal.features / editor.ligatures"' \
		<<<"$suggest_json"
}

cmd_remove() {
	local key=$1
	local src registry toml entry active_family entry_family
	local removable start end final_line was_last
	local registry_tmp new_final new_close
	local c hits toml_tmp

	src=$(chezmoi source-path) || die "chezmoi source-path failed"
	registry="$src/dot_config/font/registry.json"
	toml="$src/.chezmoidata.toml"

	entry=$(jq -e --arg k "$key" '.[$k] // empty' "$registry") ||
		die "unknown font '$key'; run 'font' with no arguments to see the roster"

	# The active-font guard has to run before anything else touches disk: an
	# active font uninstalled out from under Ghostty and VS Code leaves both
	# configs pointing at a family nothing provides any more.
	ensure_family_cache
	active_family=$(current_terminal_family)
	entry_family=$(jq -r '.terminal.family' <<<"$entry")
	[ "$active_family" != "$entry_family" ] ||
		die "'$key' is the active terminal font; switch to something else before removing it"

	# Read-only, before any write: this entry's casks minus every cask any
	# OTHER entry declares. Keying off declared casks rather than a 'font-'
	# name prefix is what keeps a cask shared with another roster entry (the
	# symbols-only font) safe, and keeps a cask no entry declares (font-lora,
	# a document face) out of scope entirely.
	removable=$(jq -r --arg k "$key" '
		([.[$k].terminal.casks[]?, .[$k].editor.casks[]?] | unique) as $mine
		| ([to_entries[] | select(.key != $k) | (.value.terminal.casks[]?, .value.editor.casks[]?)] | unique) as $others
		| ($mine - $others)[]
	' "$registry")

	# ---- validate every anchor before writing anything ----
	final_line=$(registry_final_brace_line "$registry") ||
		die "$registry has no single unambiguous closing '}' to anchor a write on"
	read -r start end < <(registry_entry_bounds "$registry" "$key")
	[ -n "$start" ] && [ -n "$end" ] ||
		die "could not find the bounds of registry entry '$key'"

	for c in $removable; do
		hits=$(awk -v anchor="{ name = \"$c\"," 'index($0, anchor)' "$toml" | wc -l | tr -d ' ')
		[ "$hits" -eq 1 ] ||
			die "expected exactly one '.chezmoidata.toml' line for cask '$c', found $hits"
	done

	# ---- delete the registry block ----
	was_last=0
	[ "$end" -eq $((final_line - 1)) ] && was_last=1

	registry_tmp=$(mktemp)
	awk -v s="$start" -v e="$end" 'NR < s || NR > e' "$registry" >"$registry_tmp"

	if [ "$was_last" -eq 1 ]; then
		# The entry that used to sit before the one just deleted is now last,
		# but it still carries the trailing comma that separated it from a
		# neighbor that no longer exists. JSON forbids a comma before `}`.
		new_final=$(registry_final_brace_line "$registry_tmp") ||
			die "$registry lost its unique closing '}' while removing '$key'"
		new_close=$((new_final - 1))
		local fixed_tmp
		fixed_tmp=$(mktemp)
		awk -v c="$new_close" 'NR == c { sub(/,$/, ""); print; next } { print }' "$registry_tmp" >"$fixed_tmp"
		mv "$fixed_tmp" "$registry_tmp"
	fi

	jq . "$registry_tmp" >/dev/null ||
		die "registry would not parse as JSON after removing '$key'; nothing written"

	# ---- delete the package entries ----
	toml_tmp=$(mktemp)
	cp "$toml" "$toml_tmp"
	for c in $removable; do
		local step_tmp
		step_tmp=$(mktemp)
		awk -v anchor="{ name = \"$c\"," '!index($0, anchor)' "$toml_tmp" >"$step_tmp"
		mv "$step_tmp" "$toml_tmp"
	done

	replace_preserving_mode "$registry_tmp" "$registry"
	replace_preserving_mode "$toml_tmp" "$toml"

	# No `|| true`: a cask that refuses to uninstall should surface rather
	# than leave the registry saying it's gone while brew disagrees.
	for c in $removable; do
		brew uninstall --cask "$c"
	done

	chezmoi apply --force "$REGISTRY"
	rebuild_family_cache

	show_diff "$registry"
	show_diff "$toml"
}

usage() {
	echo "usage: font [<key> [size]] [--force] [--refresh]"
	echo "       font --add <cask> | --remove <key> | --inspect <family|path>"
	echo "  font                        list the roster and show what's active"
	echo "  font <key>                  switch Ghostty and VS Code to <key>"
	echo "  font <key> 16               switch, overriding the registry's size"
	echo "  font <key> --force          switch without checking that the font is installed"
	echo "  font --refresh              rebuild the cached list of installed families"
	echo "  font --add <cask>           install a cask, inspect it, and register it"
	echo "    [--family <name>]           pick a family when the cask registers several"
	echo "    [--key <key>]               override the derived roster key"
	echo "    [--set <tag>[,<tag>...]]    enable named stylistic sets (repeatable)"
	echo "  font --remove <key>         drop a roster entry, its casks, and its cache entry"
	echo "  font --rm <key>             alias for --remove"
	echo "  font --inspect <family|path>  report ligature evidence without touching the roster"
}

main() {
	# Scalars rather than an array of positionals: /bin/bash is 3.2, where
	# expanding an empty array under `set -u` aborts. That one cost the teardown
	# script a crash on its second run; see decisionLog 2026-08-05.
	local key="" size="" force=0 refresh=0
	local add_cask="" remove_key="" inspect_target=""
	local family_choice="" key_override="" sets=""

	require_deps

	while [ $# -gt 0 ]; do
		case $1 in
		-h | --help)
			usage
			return 0
			;;
		--force) force=1 ;;
		--refresh) refresh=1 ;;
		--add) [ $# -ge 2 ] || die "--add needs a cask name"; add_cask=$2; shift ;;
		--remove | --rm) [ $# -ge 2 ] || die "--remove needs a roster key"; remove_key=$2; shift ;;
		--inspect) [ $# -ge 2 ] || die "--inspect needs a family name or file path"; inspect_target=$2; shift ;;
		--family) [ $# -ge 2 ] || die "--family needs a value"; family_choice=$2; shift ;;
		--key) [ $# -ge 2 ] || die "--key needs a value"; key_override=$2; shift ;;
		--set)
			[ $# -ge 2 ] || die "--set needs a stylistic set tag"
			# Comma-accumulating rather than last-wins, so `--set ss01 --set ss02`
			# and `--set ss01,ss02` land the same way.
			sets="${sets:+$sets,}$2"
			shift
			;;
		-*) die "unknown option '$1'; run 'font --help'" ;;
		*)
			if [ -z "$key" ]; then
				key=$1
			elif [ -z "$size" ]; then
				size=$1
			else
				die "unexpected argument '$1'; usage is 'font [<key> [size]]'"
			fi
			;;
		esac
		shift
	done

	# One writing mode at a time. Each of --add/--remove/--inspect answers a
	# different question than "switch to this key", so mixing them with a
	# positional key or with each other has no coherent meaning to fall back to.
	local modes=0
	[ -z "$add_cask" ] || modes=$((modes + 1))
	[ -z "$remove_key" ] || modes=$((modes + 1))
	[ -z "$inspect_target" ] || modes=$((modes + 1))
	[ "$modes" -le 1 ] || die "--add, --remove/--rm, and --inspect are mutually exclusive"
	if [ "$modes" -eq 1 ]; then
		[ -z "$key" ] || die "--add, --remove/--rm, and --inspect cannot be combined with a positional key"
	fi

	# --family/--key/--set shape an entry that --add is about to write; without
	# --add they have nothing to attach to.
	if [ -n "$family_choice" ] || [ -n "$key_override" ] || [ -n "$sets" ]; then
		[ -n "$add_cask" ] || die "--family, --key, and --set are only legal with --add"
	fi

	# --force and a size override only mean something next to a key to switch
	# to; --refresh has no such tie and stays legal on its own, as today.
	if [ "$force" -eq 1 ] || [ -n "$size" ]; then
		[ -n "$key" ] || die "--force and a size override require a positional font key"
	fi

	[ "$refresh" -eq 0 ] || rebuild_family_cache

	if [ -n "$add_cask" ]; then
		cmd_add "$add_cask" "$family_choice" "$key_override" "$sets"
	elif [ -n "$remove_key" ]; then
		cmd_remove "$remove_key"
	elif [ -n "$inspect_target" ]; then
		# A path on disk vs. a family name are disambiguated by existence alone;
		# font-inspect owns the rest of the distinction.
		if [ -e "$inspect_target" ]; then
			exec font-inspect "$inspect_target"
		else
			exec font-inspect --family "$inspect_target"
		fi
	elif [ -z "$key" ]; then
		cmd_list
	else
		cmd_switch "$key" "$size" "$force"
	fi
}

main "$@"
