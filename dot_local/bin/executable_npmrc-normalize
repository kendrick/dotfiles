#!/usr/bin/env python3
"""Keep the synced npmrc free of this machine's corporate proxy.

`proxy` / `https-proxy` are the problem keys. This box sits behind a corporate
gateway and npm breaks without them, so live ~/.npmrc carries:

    proxy=http://<gateway>:<port>
    https-proxy=http://<gateway>:<port>

dotfiles-sync runs a blanket `chezmoi re-add`, which has no way to tell that
line from `audit=false` or the shared registry auth token — it just captures
whatever live holds. So every sync re-commits this machine's gateway address
into an encrypted file whose whole point is to be shared across machines that
don't sit behind it. Commit 00e8e17 stripped these by hand once already, and
auto-sync commit eb2b919 put them straight back four days later, because
nothing stood between the live file and the next re-add. This is that thing.

Runs AFTER re-add, and edits source rather than the live file. That ordering
is the whole point: strip the live copy instead and npm stops working on this
machine until someone notices and re-adds the proxy lines by hand. Left
alone, live keeps the proxy across restarts and only a manual `chezmoi apply`
would clear it from live, which is rare — the sync never applies.

Two jobs, and the second one outlived the first. Stripping the proxy is the
reason this exists, but any path that leaves source holding HEAD's exact
plaintext under fresh ciphertext gets the committed blob restored, strip or
no strip. `chezmoi re-add` compares live against source rather than against
HEAD, so an app that writes a key and later takes it back produces exactly
that state with nothing to strip, and age's nondeterminism turns it into a
full commit that changes nothing.

Doing nothing is the common case and costs one decrypt. Line-based, not JSON:
npmrc is ini-flavored key=value text, not JSON, and a json.loads/dumps
round-trip would destroy comments, blank lines, and ordering that npmrc
legitimately allows.
"""

import glob
import os
import re
import subprocess
import sys
import tempfile

TARGET = os.path.expanduser("~/.npmrc")

# Distinctive enough for .gitignore to match and for the sweep above to recognize its own
# leavings without touching anything else in the source dir.
TMP_PREFIX = ".normalize-tmp-"

# Keys that describe this machine's network path rather than shared intent.
# Everything else in .npmrc (audit, the registry auth token) is shared intent
# and keeps syncing exactly as before.
LOCAL_KEYS = ("proxy", "https-proxy", "http-proxy", "noproxy", "no-proxy")

# npm config keys are case-insensitive and tolerate whitespace around `=`, so
# matching has to key off everything left of the first `=`, lowercased and
# trimmed — not a substring match, which would also catch the registry auth
# line's `//registry.npmjs.org/:_authToken=...` if "proxy" ever appeared in a
# URL there.
_KEY_RE = re.compile(r"^\s*([^=]+?)\s*=")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def decrypt(path):
    result = run(["chezmoi", "decrypt", path])
    return result.stdout if result.returncode == 0 else None


def identity_is_absent():
    """Whether this machine has no age identity at all, the normal bootstrap state.

    True for absent or zero-byte, False for a real file, None when the path won't resolve.

    The size test mirrors .chezmoiignore's on purpose, and the two have to agree.
    That template is what decides whether this encrypted file is a managed target at all,
    so a normalizer drawing the line somewhere else would create a state where the file
    is managed, source holds live's machine-local keys, and an undecryptable read still
    reports a clean bootstrap skip. Zero bytes counts as absent because a failed
    `op read > key.txt` creates the file before op writes to it.

    Asks chezmoi for the path rather than hardcoding it, which is what keeps the two
    definitions from drifting apart. dotfiles-sync hardcodes the same path only because
    chezmoi is the thing that guard exists to check; nothing here has that constraint.
    """
    result = run(["chezmoi", "execute-template", "{{ .chezmoi.config.age.identity }}"])
    if result.returncode != 0:
        return None
    path = result.stdout.strip()
    if not path:
        return None
    try:
        return os.path.getsize(path) == 0
    except OSError:
        return True


def source_differs_from_head(repo, src):
    """Whether the encrypted blob on disk differs from the committed one.

    Compares ciphertext, which is the whole point: the states this guards are exactly the
    ones where no key is available to say what changed. Any git failure counts as a
    difference, since an unanswerable question is not an assurance.
    """
    result = run(["git", "-C", repo, "status", "--porcelain", "--", src])
    if result.returncode != 0:
        return True
    return bool(result.stdout.strip())


def head_plaintext(repo, src):
    """What the last commit holds, decrypted. None if it isn't committed yet.

    chezmoi decrypt wants a path, so the blob has to land on disk first.
    """
    rel = os.path.relpath(src, repo)
    blob = run(["git", "-C", repo, "show", f"HEAD:{rel}"])
    if blob.returncode != 0:
        return None
    with tempfile.NamedTemporaryFile("w", suffix=".age", delete=False) as fh:
        fh.write(blob.stdout)
        tmp = fh.name
    try:
        return decrypt(tmp)
    finally:
        os.unlink(tmp)


def strip_local_keys(plain):
    """Line-based strip, not a JSON round-trip: npmrc isn't JSON, and a
    parse/re-serialize would flatten the comments, blank lines, and spacing
    it legitimately allows. Byte-for-byte preservation of everything else
    matters because age ciphertext doesn't delta — any incidental
    reformatting here would cost a full re-encrypt for no reason.
    """
    removed = []
    kept_lines = []
    for line in plain.splitlines(keepends=True):
        match = _KEY_RE.match(line)
        key = match.group(1).lower() if match else None
        if key in LOCAL_KEYS:
            removed.append(key)
            continue
        kept_lines.append(line)
    return "".join(kept_lines), removed


def main():
    src = run(["chezmoi", "source-path", TARGET])
    if src.returncode != 0:
        print(".npmrc isn't a chezmoi target; nothing to normalize.", file=sys.stderr)
        return 0
    src = src.stdout.strip()

    repo = run(["chezmoi", "source-path"])
    if repo.returncode != 0:
        print("chezmoi not available; skipping npmrc normalize.", file=sys.stderr)
        return 0
    repo = repo.stdout.strip()

    plain = decrypt(src)
    if plain is None:
        absent = identity_is_absent()
        if absent is True:
            # An absent identity is the normal bootstrap state only while nothing has been
            # captured yet. `.chezmoiignore` skips this target whenever the key is missing
            # or zero bytes, so a source that differs from HEAD was written by an earlier
            # run that did have one. dotfiles-sync now aborts between re-add and commit,
            # which makes a stranded capture a designed outcome rather than only a crash,
            # and calling that a clean bootstrap hands it straight to `git add -A`.
            if source_differs_from_head(repo, src):
                print(
                    f"couldn't decrypt .npmrc, no age identity, and source differs from "
                    f"HEAD; refusing to report success. Restore it with: "
                    f"git -C {repo} checkout HEAD -- {src}",
                    file=sys.stderr,
                )
                return 1
            # No age key on this machine, which is a normal state mid-bootstrap. The
            # encrypted config isn't deployed there either, so there's nothing to strip.
            print("couldn't decrypt .npmrc; skipping normalize.", file=sys.stderr)
            return 0
        # An identity that exists but can't open this blob is the dangerous case, not the
        # harmless one. age encrypts to a recipient hardcoded in .chezmoi.toml, so a
        # corrupt or foreign key still lets `chezmoi re-add` capture live's machine-local
        # keys into source — only reading them back failed. Since dotfiles-sync now aborts
        # on a nonzero normalizer and on nothing else, reporting success here is what
        # would commit the unstripped blob.
        reason = (
            "the age identity can't be resolved"
            if absent is None
            else "an age identity is present"
        )
        print(
            f"couldn't decrypt .npmrc and {reason}; refusing to report success.",
            file=sys.stderr,
        )
        return 1

    payload, removed = strip_local_keys(plain)

    # Checked before the "nothing to strip" exit, not after, because a proxy
    # line is only one of the ways this file ends up re-encrypted for no
    # reason. `chezmoi re-add` compares live against the *source's*
    # plaintext, not against HEAD, so an app that writes a key and later
    # takes it back leaves source holding HEAD's exact content under fresh
    # ciphertext, with nothing local to strip. Gating this on `removed` alone
    # would leave that copy dirty until a sync committed pure nondeterminism
    # to a public repo's history — exactly what bcb395e fixed for the
    # sibling settings-normalize script.
    #
    # age encrypts nondeterministically, so restoring the committed blob is
    # the only thing that actually leaves no diff. Re-encrypting identical
    # content just hands the sync another bogus commit to make.
    if payload == head_plaintext(repo, src):
        # `checkout HEAD --`, not `checkout --`. The bare form restores from
        # the index, which is the wrong tree to compare against: a sync that
        # died between `git add -A` and `git commit` leaves the proxy lines
        # staged, and restoring that would put them straight back while this
        # reported no net change. Naming HEAD also resets the index entry, so
        # a half-finished previous run can't leak into this one.
        checkout = run(["git", "-C", repo, "checkout", "HEAD", "--", src])
        if checkout.returncode != 0:
            print(f"failed to restore {src}: {checkout.stderr}", file=sys.stderr)
            return 1
        if removed:
            print(f"dropped {', '.join(removed)} from source (no net change)")
        else:
            print("source already matches HEAD; restored the committed blob")
        return 0

    # Source genuinely differs from HEAD and carries nothing machine-local, so this is a
    # real settings change. Leave it for the sync to commit; re-encrypting here would
    # only swap one valid ciphertext for another.
    if not removed:
        return 0

    encrypted = run(["chezmoi", "encrypt"], input=payload)
    if encrypted.returncode != 0:
        print(f"failed to re-encrypt .npmrc: {encrypted.stderr}", file=sys.stderr)
        return 1
    # A SIGKILL or a power loss between the temp's creation and the rename skips the
    # cleanup below, stranding the file in the worktree. Sweep what a previous run left
    # before adding another; .gitignore covers the window in between, when this hasn't
    # run yet and the daily sync's `git add -A` has.
    for stale in glob.glob(os.path.join(os.path.dirname(src), TMP_PREFIX + "*")):
        try:
            os.unlink(stale)
        except OSError:
            pass

    # Rename a finished file into place rather than writing through the existing one.
    # `open(src, "w")` truncates before the ciphertext lands, so an interrupted run leaves
    # a partial blob — and the sync's `git add -A` would commit that, producing an
    # .npmrc in history that no key can open. The temp file goes in src's own
    # directory because os.replace is only atomic within a filesystem, and the fsync is
    # what makes the rename swap in bytes that actually reached the disk.
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", dir=os.path.dirname(src), prefix=TMP_PREFIX, suffix=".tmp", delete=False
        ) as fh:
            tmp = fh.name
            fh.write(encrypted.stdout)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, src)
    except OSError as exc:
        # Leaving the temp file behind would put an untracked file in the source dir for
        # the next `git add -A` to sweep up.
        if tmp is not None and os.path.exists(tmp):
            os.unlink(tmp)
        print(f"failed to write {src}: {exc}", file=sys.stderr)
        return 1
    print(f"dropped {', '.join(removed)} from source")
    return 0


if __name__ == "__main__":
    sys.exit(main())
