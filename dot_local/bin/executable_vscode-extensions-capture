#!/bin/bash
# vscode-extensions-capture—merge this machine's VS Code extensions into the tracked list.
#
# Capture used to overwrite dot_config/vscode-extensions.txt with whatever `code
# --list-extensions` printed locally, so the last machine to sync won: an extension
# removed on one machine came back from another that still had it, and one this machine
# never installed was dropped for everybody (kendrick/dotfiles#75). This is now the only
# code that writes either list, and both dotfiles-sync and the code() wrapper call it.
#
#   vscode-extensions-capture                  merge and write
#   vscode-extensions-capture --removed <id>   record <id> as removed, then merge
#   vscode-extensions-capture --restored <id>  take <id> out of the removed list, then merge
#
# `--profile <name>` points either action at a VS Code profile's own files under
# dot_config/vscode-profiles/ instead of the default lists (#45). Every run merges the
# default list and then every tracked profile VS Code has registered, whatever the action.
#
# Prints `updated` on stdout when it changed any list, so callers need not diff the files.

set -euo pipefail

usage() {
	echo "usage: vscode-extensions-capture [--profile <name>] [--removed <id> | --restored <id>]"
}

action=""
target=""
profile=""
have_profile=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--removed | --restored)
		if [ -n "$action" ] || [ $# -lt 2 ] || [ -z "$2" ]; then
			usage >&2
			exit 2
		fi
		action="$1"
		target="$2"
		shift 2
		;;
	--profile)
		if [ -n "$have_profile" ] || [ $# -lt 2 ] || [ -z "$2" ]; then
			usage >&2
			exit 2
		fi
		have_profile=1
		profile="$2"
		shift 2
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
done
# VS Code names its built-in profile Default, and `--profile Default` addresses it.
if [ "$profile" = "Default" ]; then
	profile=""
fi

if ! command -v code &>/dev/null; then
	echo "code CLI not found, skipping"
	exit 0
fi

SRC="$(chezmoi source-path)"
LIST="$SRC/dot_config/vscode-extensions.txt"
REMOVED="$SRC/dot_config/vscode-extensions-removed.txt"

LIST_HEADER='# VS Code extensions to install
# Edit this list and run `chezmoi apply` to sync.'
REMOVED_HEADER='# VS Code extensions removed on purpose. Capture never adds these back.
# Remove a line (or run `code --install-extension <id>`) to allow it again.'
PROFILE_DIR="$SRC/dot_config/vscode-profiles"
STORAGE="$HOME/Library/Application Support/Code/User/globalStorage/storage.json"

profile_list_header() {
	printf '%s\n%s' "# VS Code extensions for the $1 profile, on top of vscode-extensions.txt" \
		'# Edit this list and run `chezmoi apply` to sync.'
}

profile_removed_header() {
	printf '%s\n%s' "# Extensions removed from the $1 VS Code profile on purpose. Capture never adds these back." \
		"# Remove a line (or run \`code --install-extension <id> --profile $1\`) to allow it again."
}

# The name becomes a path, so only the shape the installer accepts counts. `<name>-removed`
# is a profile's tombstone file, never a profile.
profile_tracked() {
	case "$1" in
	"" | *-removed | *[!a-z0-9-]*) return 1 ;;
	esac
	[ -f "$PROFILE_DIR/$1.txt" ]
}

if [ -n "$profile" ] && ! profile_tracked "$profile"; then
	echo "vscode-extensions-capture: profile $profile is not tracked, nothing recorded" >&2
	exit 0
fi

# The lock lives outside the source tree because the next auto-sync runs `git add -A` there
# and would commit it. It's per-user so two accounts on one Mac never contend.
lock_root="${TMPDIR:-/tmp}"
LOCK="${lock_root%/}/vscode-extensions-capture.$(id -u).lock"
BREAK="$LOCK.break"
LOCK_WAIT=10

tmp=""
wrote=""

# The temp file sits beside its target (same filesystem, so mv is atomic) and so inside the
# source tree, where a stray one gets committed by the next auto-sync. Every write runs in
# this shell, never in a $(...) or pipeline subshell, so this trap sees $tmp. INT and TERM
# exit through it too, which is the case an explicit rm on each failure path can't cover.
# The lock goes only if it names $$, so a run that never got it can't delete a live holder's.
cleanup() {
	if [ -n "$tmp" ]; then
		rm -f "$tmp"
	fi
	if [ "$(readlink "$LOCK" 2>/dev/null)" = "$$" ]; then
		rm -f "$LOCK"
	fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

die() {
	echo "vscode-extensions-capture: $*" >&2
	exit 1
}

# Two waiters can read the same dead pid. If both removed the lock, the slower one would
# delete the faster one's fresh lock and both would run. lockf(1) takes a kernel lock, so one
# waiter breaks at a time. The kernel drops that lock if its waiter dies, so the breaker can't
# go stale. Under it, the lock goes only if it still names the same dead pid. Nothing but a
# break removes another process's lock, so it can't change between that read and the rm.
break_stale() {
	lockf -k -t 2 "$BREAK" /bin/sh -c \
		'[ "$(readlink "$1")" = "$2" ] && ! kill -0 "$2" 2>/dev/null && rm -f "$1"; exit 0' \
		sh "$LOCK" "$1" 2>/dev/null || true
}

# Two overlapping uninstalls would each read the same removed set, and the last writer would
# drop the other's tombstone. The lock is a symlink whose target is the holder's pid, because
# symlink(2) creates it and records the pid in one atomic step. A mkdir lock plus a pid file
# had a window that left a lock naming nobody, which no waiter could ever call stale.
acquire_lock() {
	local deadline=$((SECONDS + LOCK_WAIT)) holder
	[ -d "$lock_root" ] || die "lock dir $lock_root does not exist"
	while :; do
		# ln -s onto a real directory makes a link inside it and reports success, and -n stops
		# it following a lock link that happens to resolve to one.
		if [ -d "$LOCK" ] && [ ! -L "$LOCK" ]; then
			die "$LOCK is a directory, not a lock this helper made"
		fi
		if ln -sn "$$" "$LOCK" 2>/dev/null; then
			return 0
		fi
		holder="$(readlink "$LOCK" 2>/dev/null || true)"
		# A holder killed before its EXIT trap ran (SIGKILL, a crash) must not wedge
		# capture until a reboot clears $TMPDIR.
		if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
			break_stale "$holder"
		fi
		if [ "$SECONDS" -ge "$deadline" ]; then
			die "$LOCK still held by pid ${holder:-unknown} after ${LOCK_WAIT}s"
		fi
		sleep 0.1
	done
}

# grep exits 1 for a file holding only comments, which is an empty list. Anything above 1 is
# a failed read, and merging from it would delete tracked ids or tombstones.
ids_of() {
	[ -f "$1" ] || return 0
	local rc=0
	grep -vE '^[[:space:]]*(#|$)' "$1" 2>/dev/null || rc=$?
	[ "$rc" -le 1 ]
}

# The marketplace treats ids case-insensitively, so sorting and de-duplicating must too.
normalize() {
	sed '/^$/d' | sort -f | awk '!seen[tolower($0)]++'
}

# Skips identical bytes so a no-op sync leaves the mtime alone. Returns are explicit because
# callers test the status, which switches errexit off inside the function.
write_if_changed() {
	local file="$1" header="$2" body="$3"
	wrote=""
	tmp="$(mktemp "$file.XXXXXX")" || return 1
	{
		printf '%s\n' "$header" && { [ -z "$body" ] || printf '%s\n' "$body"; }
	} >"$tmp" || return 1
	if [ -f "$file" ] && cmp -s "$tmp" "$file"; then
		rm -f "$tmp"
		tmp=""
		return 0
	fi
	chmod 644 "$tmp" || return 1
	mv "$tmp" "$file" || return 1
	tmp=""
	wrote=1
}

# grep exits 1 when it drops every line, which is an empty result. Anything above 1 is a
# failed filter, and writing its empty output would wipe the list or every tombstone (#80).
without() {
	local drop="$1" rc=0
	if [ -z "$drop" ]; then
		cat
		return 0
	fi
	grep -vixFf <(printf '%s\n' "$drop") || rc=$?
	[ "$rc" -le 1 ]
}

# Runs before the lock because it's the slow call and reads neither file.
installed="$(code --list-extensions)" || die "code --list-extensions failed"

# The CLI exits 1 ("Profile not found") for a profile VS Code never registered. That's
# normal on a machine that hasn't applied yet or has a profile pending, so this loop skips
# those profiles and leaves their files alone. It lists the profile an action names either
# way, because the wrapper only passes one after `code ... --profile` succeeded.
p_names=()
p_installed=()
have_jq=""
if command -v jq >/dev/null 2>&1; then
	have_jq=1
fi
jq_noted=""
for f in "$PROFILE_DIR"/*.txt; do
	[ -f "$f" ] || continue
	name="${f##*/}"
	name="${name%.txt}"
	profile_tracked "$name" || continue
	if [ "$name" != "$profile" ]; then
		if [ -z "$have_jq" ]; then
			if [ -z "$jq_noted" ]; then
				echo "vscode-extensions-capture: jq not found, profiles skipped" >&2
				jq_noted=1
			fi
			continue
		fi
		[ -f "$STORAGE" ] || continue
		rc=0
		jq -e --arg n "$name" '(.userDataProfiles // []) | any(.name == $n)' "$STORAGE" \
			>/dev/null 2>&1 || rc=$?
		if [ "$rc" -gt 1 ]; then
			echo "vscode-extensions-capture: cannot read $STORAGE, profile $name skipped" >&2
		fi
		[ "$rc" -eq 0 ] || continue
	fi
	one="$(code --list-extensions --profile "$name")" ||
		die "code --list-extensions --profile $name failed"
	p_names+=("$name")
	p_installed+=("$one")
done

acquire_lock

# Every read happens before any write, so a failed read leaves every file as it was.
list_ids="$(ids_of "$LIST")" || die "cannot read $LIST"
removed_ids="$(ids_of "$REMOVED")" || die "cannot read $REMOVED"
p_lists=()
p_removed=()
i=0
while [ "$i" -lt "${#p_names[@]}" ]; do
	name="${p_names[$i]}"
	one="$(ids_of "$PROFILE_DIR/$name.txt")" || die "cannot read $PROFILE_DIR/$name.txt"
	p_lists+=("$one")
	one="$(ids_of "$PROFILE_DIR/$name-removed.txt")" || die "cannot read $PROFILE_DIR/$name-removed.txt"
	p_removed+=("$one")
	i=$((i + 1))
done

save_removed=""
if [ -z "$profile" ]; then
	case "$action" in
	--removed)
		if ! printf '%s\n' "$removed_ids" | grep -qixF -- "$target"; then
			removed_ids="$(printf '%s\n%s\n' "$removed_ids" "$target")"
		fi
		save_removed=1
		;;
	--restored)
		removed_ids="$(printf '%s\n' "$removed_ids" | without "$target")" ||
			die "cannot drop $target from the ids in $REMOVED"
		if [ -f "$REMOVED" ]; then
			save_removed=1
		fi
		;;
	esac
fi
removed_ids="$(printf '%s\n' "$removed_ids" | normalize)"

# Removed wins: an id on both sides is dropped, so one machine that still has an extension
# installed cannot put back what another removed on purpose.
merged="$(
	{
		printf '%s\n' "$list_ids"
		printf '%s\n' "$installed"
	} | normalize | without "$removed_ids"
)" || die "cannot drop removed ids from the merge of $LIST"

# Profile merge (#45):
#
#   new = normalize( profile_list ∪ (installed_profile − default_removed) ) − default_merged − profile_removed
#
# The installer puts the whole default list into every profile, so without the
# default_removed term every id uninstalled from the default would come back as an extra in
# each profile. That term applies only to the installed half, because a tracked profile
# list is explicit membership. That's how a moved id sits in web.txt while tombstoned in
# the default.
# Subtracting default_merged keeps an id from living in the default and a profile at once.
p_new=()
p_saves=()
i=0
while [ "$i" -lt "${#p_names[@]}" ]; do
	name="${p_names[$i]}"
	plist="${p_lists[$i]}"
	premoved="${p_removed[$i]}"
	psave=""
	if [ "$name" = "$profile" ]; then
		case "$action" in
		--removed)
			if ! printf '%s\n' "$premoved" | grep -qixF -- "$target"; then
				premoved="$(printf '%s\n%s\n' "$premoved" "$target")"
			fi
			psave=1
			;;
		--restored)
			premoved="$(printf '%s\n' "$premoved" | without "$target")" ||
				die "cannot drop $target from the ids in $PROFILE_DIR/$name-removed.txt"
			if [ -f "$PROFILE_DIR/$name-removed.txt" ]; then
				psave=1
			fi
			# Add the id to the tracked list, because a default-tombstoned id never gets in
			# through the installed half. An id in default_merged still loses below.
			plist="$(printf '%s\n%s\n' "$plist" "$target")"
			;;
		esac
	fi
	premoved="$(printf '%s\n' "$premoved" | normalize)"
	p_removed[$i]="$premoved"
	extra="$(printf '%s\n' "${p_installed[$i]}" | without "$removed_ids")" ||
		die "cannot drop default removed ids from profile $name's installed set"
	one="$(
		{
			printf '%s\n' "$plist"
			printf '%s\n' "$extra"
		} | normalize | without "$merged" | without "$premoved"
	)" || die "cannot merge $PROFILE_DIR/$name.txt"
	p_new+=("$one")
	p_saves+=("$psave")
	i=$((i + 1))
done

changed=""
if [ -n "$save_removed" ]; then
	write_if_changed "$REMOVED" "$REMOVED_HEADER" "$removed_ids" || die "cannot write $REMOVED"
	[ -z "$wrote" ] || changed=1
fi
write_if_changed "$LIST" "$LIST_HEADER" "$merged" || die "cannot write $LIST"
[ -z "$wrote" ] || changed=1
i=0
while [ "$i" -lt "${#p_names[@]}" ]; do
	name="${p_names[$i]}"
	if [ -n "${p_saves[$i]}" ]; then
		write_if_changed "$PROFILE_DIR/$name-removed.txt" "$(profile_removed_header "$name")" \
			"${p_removed[$i]}" || die "cannot write $PROFILE_DIR/$name-removed.txt"
		[ -z "$wrote" ] || changed=1
	fi
	write_if_changed "$PROFILE_DIR/$name.txt" "$(profile_list_header "$name")" "${p_new[$i]}" ||
		die "cannot write $PROFILE_DIR/$name.txt"
	[ -z "$wrote" ] || changed=1
	i=$((i + 1))
done
if [ -n "$changed" ]; then
	echo updated
fi
