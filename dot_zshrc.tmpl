# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Download Znap, if it's not there yet.
[[ ! -d ~/.znap-repos/znap ]] && git clone --depth 1 -- https://github.com/marlonrichert/zsh-snap.git ~/.znap-repos/znap
source ~/.znap-repos/znap/znap.zsh  # Start Znap

# XDG-style config layout — managed by chezmoi
export ZSH_CONFIG=$HOME/.config/zsh

source $ZSH_CONFIG/exports.zsh && \
source $ZSH_CONFIG/plugins.zsh

. $HOMEBREW_PREFIX/etc/profile.d/z.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
source $HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme

source $ZSH_CONFIG/keybindings.zsh
source $ZSH_CONFIG/styles.zsh
source $ZSH_CONFIG/aliases.zsh
source $ZSH_CONFIG/options.zsh

# NVM_DIR is set in exports.zsh
. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
. "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"

source $ZSH_CONFIG/functions.zsh
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# pnpm
export PNPM_HOME="{{ .chezmoi.homeDir }}/.local/share/pnpm"
# pnpm 11 puts global shims in $PNPM_HOME/bin; keep $PNPM_HOME on PATH too so any
# pre-v11 shims still living at the root resolve. Order matters — bin first wins.
for _pnpm_dir in "$PNPM_HOME/bin" "$PNPM_HOME"; do
  case ":$PATH:" in
    *":$_pnpm_dir:"*) ;;
    *) export PATH="$_pnpm_dir:$PATH" ;;
  esac
done
unset _pnpm_dir
# pnpm end

fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select

# bun
[ -s "{{ .chezmoi.homeDir }}/.bun/_bun" ] && source "{{ .chezmoi.homeDir }}/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Machine-local overrides, sourced last so they beat everything above. A client machine's
# proxy exports live here: the gateway hostname belongs to the client, not to me, so it
# can't go in a public repo, and it can't be a template value either—a machine needs a
# working proxy before the first apply can succeed. Absent on most machines, hence the
# guard. chezmoi never manages this file; .chezmoiignore is what keeps it that way.
[[ ! -r ~/.zshrc.local ]] || source ~/.zshrc.local
