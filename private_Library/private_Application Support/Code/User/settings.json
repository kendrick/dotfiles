{
	"diffEditor.codeLens": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.sortJSON": "explicit",
		"source.fixAll.eslint": "explicit",
		"source.fixAll.stylelint": "explicit",
		"source.organizeImports": "explicit",
		"source.removeUnusedImports": "never",
	},
	"editor.codeLens": true,
	"editor.colorDecorators": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "'FantasqueSansM Nerd Font', Menlo, Monaco, 'Courier New', monospace",
	"editor.fontLigatures": "'calt'",
	"editor.fontVariations": "",
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"editor.guides.bracketPairs": "active",
	"editor.indentSize": "tabSize",
	"editor.linkedEditing": true,
	"editor.minimap.autohide": "mouseover",
	"editor.renderWhitespace": "boundary",
	"editor.showFoldingControls": "always",
	"editor.stickyTabStops": true,
	"editor.suggestSelection": "recentlyUsed",
	"editor.tabCompletion": "on",
	"editor.tabSize": 2,
	"terminal.integrated.enableMultiLinePasteWarning": "auto",
	"terminal.integrated.hideOnStartup": "whenEmpty",
	"window.confirmSaveUntitledWorkspace": false,
	"window.autoDetectColorScheme": true,
	"workbench.preferredDarkColorTheme": "SynthWave '84",
	"workbench.colorTheme": "Bearded Theme feat. Mintshake D Raynh",
	"workbench.preferredLightColorTheme": "Bearded Theme feat. Mintshake D Raynh",
	"git.confirmSync": false,
	"git.autofetch": true,
	"redhat.telemetry.enabled": false,
	"editor.insertSpaces": false,
	"settingsSync.ignoredSettings": [],
	"[xml]": {
		"editor.defaultFormatter": "redhat.vscode-xml",
	},
	"svgPreview.autoOpen": false,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"debug.disassemblyView.showSourceCode": false,
	"claudeCode.selectedModel": "default",
	"claudeCode.preferredLocation": "panel",
	"editor.minimap.enabled": false,
	"git.openRepositoryInParentFolders": "never",
	"editor.lineHeight": 0,
	"editor.fontSize": 15,
	"extensions.ignoreRecommendations": true,
	"terminal.integrated.fontFamily": "FantasqueSansM Nerd Font",
	"terminal.integrated.fontSize": 14,
	"chat.viewSessions.orientation": "stacked",
	"chat.disableAIFeatures": true,
}
