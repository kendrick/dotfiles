# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include ~/.ssh/conductor_config

Host github_personal
	HostName github.com
	IdentityFile ~/.ssh/personal_1p.pub
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	UseKeychain no
	AddKeysToAgent no

Host github.com
	IdentityFile ~/.ssh/slalom_1p.pub
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	UseKeychain no
	AddKeysToAgent no

# Deploy key for the quantified-claude events repo. Uses the key file directly
# with no agent, so the unattended launchd render/collect job can push — the
# 1Password agent below isn't reachable from launchd's context.
Host github-qc-events
	HostName github.com
	IdentityFile ~/.ssh/quantified_claude_events_deploy
	IdentitiesOnly yes
	IdentityAgent none

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	UseKeychain no
	AddKeysToAgent no

