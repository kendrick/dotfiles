#!/bin/bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# Claude Code plugins — reinstall from intent. The decrypted plugin list is inlined
# below, so the rendered script changes whenever the plaintext manifests change.
# That inlined list is the change trigger; hashing the ciphertext would churn on
# every re-encrypt.
#
# The manifests under dot_claude/private_plugins/ are age-encrypted because they
# hold a work-only marketplace's entries and this repo is public. Personal machines
# install only the public-marketplace allowlist; work and client machines get the
# full set. The reinstall is the durable record: live ~/.claude/plugins/*.json is
# CLI-owned state that claude-plugins-capture normalizes back into source, keeping
# only the repos and specs read below so the file is identical on every machine.
#
# Those manifests are deliberately not chezmoi targets (see .chezmoiignore), so the
# teardown:data line below is what clears them — it covers the whole plugins dir,
# including the cloned marketplace repos the CLI drops alongside them.
#
# teardown:data ~/.claude/plugins

set -e

if ! command -v claude &>/dev/null; then
  echo "claude CLI not found — skipping plugin install."
  exit 0
fi

# Public git clones, so no auth needed — only network. Idempotent: skip whatever is
# already present so re-applies are cheap and a partial first run self-heals.
add_marketplace() {
  local name="$1" repo="$2"
  claude plugin marketplace list 2>/dev/null | grep -q "$name" && return 0
  echo "Adding marketplace $name ($repo)..."
  claude plugin marketplace add "$repo" 2>/dev/null || true
}

install_plugin() {
  local spec="$1"
  claude plugin list 2>/dev/null | grep -q "${spec%@*}" && return 0
  echo "Installing $spec..."
  claude plugin install "$spec" 2>/dev/null || true
}

{{/* Marketplaces a personal machine may install from. The bar is whether the repo is
     reachable without work credentials, not who wrote it, so kendrick/agent-guild
     qualifies while slalom-agent-kit is the work-only one this file is encrypted for.
     Leaving it out starved personal boxes of the guild tooling .agent-guild/CLAUDE.md
     expects to be loaded.

     The name here is "kendrick", not "agent-guild": these entries match the marketplace
     name the CLI registers, and it takes that from the repo's own
     .claude-plugin/marketplace.json rather than from the repo or plugin name. So the
     marketplace is kendrick and the plugin inside it is agent-guild@kendrick. Getting
     this wrong fails silently, since add_marketplace below discards its errors.

     No chrome-devtools-plugins entry for the same reason it isn't a marketplace at all:
     ChromeDevTools/chrome-devtools-mcp is the MCP server's own repo, and the plugin
     actually ships from claude-plugins-official. Config carried the bogus coordinate for
     a while, which left chrome-devtools-mcp enabled against a marketplace that could
     never resolve it. */ -}}
{{ $public := list "superpowers-marketplace" "claude-plugins-official" "kendrick" -}}
{{ if stat (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") -}}
{{   $marketplaces := include "dot_claude/private_plugins/encrypted_known_marketplaces.json.age" | decrypt | fromJson -}}
{{   range $name, $info := $marketplaces -}}
{{     if or (ne $.machine_role "personal") (has $name $public) -}}
add_marketplace {{ $name }} {{ $info.source.repo }}
{{     end -}}
{{   end }}
{{   $plugins := include "dot_claude/private_plugins/encrypted_installed_plugins.json.age" | decrypt | fromJson -}}
{{   range $spec, $_ := $plugins.plugins -}}
{{     $mp := splitList "@" $spec | last -}}
{{     if or (ne $.machine_role "personal") (has $mp $public) -}}
install_plugin {{ $spec }}
{{     end -}}
{{   end -}}
{{ else -}}
echo "No chezmoi decryption key present — skipping plugin reinstall."
{{ end -}}
echo "Claude Code plugins ready."
