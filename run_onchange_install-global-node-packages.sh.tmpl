#!/bin/bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# npm globals hash:  {{ include "dot_config/npm-globals.txt"  | sha256sum }}
# pnpm globals hash: {{ include "dot_config/pnpm-globals.txt" | sha256sum }}
# Re-runs whenever either list changes.

set -e

install_globals() {
  local manager="$1"
  local list_content="$2"
  if ! command -v "$manager" &>/dev/null; then
    echo "$manager not found, skipping global package install."
    return 0
  fi
  local subcommand
  case "$manager" in
    npm)  subcommand="install -g" ;;
    pnpm) subcommand="add -g" ;;
  esac
  # Best-effort: one package that won't install (an engine mismatch on an outdated
  # node, a yanked version) must never abort the whole `chezmoi apply`. The obvious
  # `cmd || true` doesn't buy that here—on macOS #!/bin/bash is bash 3.2, whose
  # errexit fires on a failing *external* command even through `|| true` or an `if !`
  # guard. Dropping errexit for the loop is the only reliable suppression. We also
  # let stderr through: when a package fails, the real reason (e.g. "requires Node.js
  # vX") is exactly what you want to see, not silence.
  set +e
  while IFS= read -r pkg; do
    [[ "$pkg" =~ ^#.*$ || -z "$pkg" ]] && continue
    echo "  $manager $subcommand $pkg"
    if ! command "$manager" $subcommand "$pkg"; then
      echo "    skipped: '$pkg' failed to install (often an outdated node)"
    fi
  done <<<"$list_content"
  set -e
}

echo "Installing global npm packages..."
install_globals npm "$(cat <<'NPMEOF'
{{ include "dot_config/npm-globals.txt" }}
NPMEOF
)"

echo "Installing global pnpm packages..."
install_globals pnpm "$(cat <<'PNPMEOF'
{{ include "dot_config/pnpm-globals.txt" }}
PNPMEOF
)"

echo "Global node packages installed."
