#!/bin/bash
# Brewfile hash: {{ includeTemplate "Brewfile" . | sha256sum }}
# Re-runs whenever the rendered Brewfile changes. Hashing the render rather than the
# template file is what makes this react to .chezmoidata.toml edits and to a machine
# turning a bundle on or off. The template itself now holds no package names at all.
#
# Installs apps. Teardown deliberately stops short of uninstalling them.
#
# teardown:none

{{ template "sh-ui.sh" . }}

if ! command -v brew &>/dev/null; then
  step_warn "packages" "Homebrew not found"
  exit 0
fi

brewfile=$(cat <<'BREWEOF'
{{ template "Brewfile" . }}
BREWEOF
)

# Homebrew 6 refuses to load formulae/casks from third-party taps unless they're
# trusted, so one untrusted tap aborts `brew bundle` on its first tapped entry and
# silently drops everything after it. Trust every tap the Brewfile declares up front;
# keying off the rendered Brewfile means new taps (and the work-only ones) are covered
# without editing this script.
echo "$brewfile" | awk '/^tap /{gsub(/"/,"",$2); print $2}' | while read -r tap; do
  brew trust --tap "$tap" 2>/dev/null || true
done

# brew names each failing entry as "<Verb> <entry> has failed!" on stderr, where Verb is
# Installing, Upgrading, or Tapping, and wraps it in red when stdout is a terminal — so
# strip SGR escapes first or an interactive apply matches nothing. brew's own closing
# line, "Homebrew Bundle failed! N Brewfile dependencies failed to install.", deliberately
# does not match this shape: it carries a count, and a count is what hid fzf. Factored out
# because #22's retry needs this same read applied to a second log, not just the first.
parse_failed_entries() {
  awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /^[A-Za-z]+ .+ has failed!$/) {
        sub(/^[A-Za-z]+ /, "", line)
        sub(/ has failed!$/, "", line)
        print line
      }
    }
  ' "$1"
}

# The other phase. brew batch-fetches everything that needs downloading before it
# installs anything, and installer.rb:84-87 returns on a fetch failure — so the install
# phase never runs and none of the per-entry lines the parser above wants can exist. The
# only line this phase emits joins every entry that needed fetching, guilty or not: the
# #17 e2e saw six names for one bad formula. Parsing it would have blamed five packages
# whose sole crime was not being downloaded yet.
parse_fetch_batch() {
  awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /Failed to fetch /) {
        sub(/^.*Failed to fetch /, "", line)
        gsub(/, /, "\n", line)
        print line
      }
    }
  ' "$1"
}

# Reports one completed `brew bundle` attempt and, the first time only, retries. $log is
# the tee'd output, $status is brew's own exit code (PIPESTATUS, not tee's), and
# $allow_retry is 1 for the initial attempt and 0 for the retry this function may itself
# trigger — #17 already ruled out looping the apply, so a second failure of either phase
# is always just reported, never retried again.
handle_bundle_result() {
  local log="$1" status="$2" allow_retry="$3"
  local failed_entries fetch_batch missing

  [ "$status" -eq 0 ] && return 0

  failed_entries=$(parse_failed_entries "$log")
  if [ -n "$failed_entries" ]; then
    echo "Homebrew ran, but could not install these Brewfile entries (its errors are above):"
    printf '%s\n' "$failed_entries" | sed 's/^/  /'
    return 0
  fi

  fetch_batch=$(parse_fetch_batch "$log")
  if [ -z "$fetch_batch" ]; then
    # brew failed in a shape this script does not recognise. Saying so beats saying
    # nothing, which is the silence the whole change exists to end.
    echo "Homebrew ran and exited $status without naming a failed entry. Its output is above."
    return 0
  fi

  # Re-derive rather than parse. Asking brew which of the batch actually resolves is what
  # separates a typo in the registry from a download that failed, and it doesn't depend on
  # the shape of an error string — the assumption that produced this bug in the first place.
  # `brew info` answers for casks and formulae alike without downloading anything.
  missing=$(while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    brew info "$entry" >/dev/null 2>&1 || printf '%s\n' "$entry"
  done <<<"$fetch_batch")

  if [ -z "$missing" ]; then
    # Every name resolves, so the registry is fine and the download isn't. Naming the whole
    # batch is the honest answer here; singling one out would be a guess.
    echo "Homebrew could not fetch these Brewfile entries, though all of them exist (its errors are above):"
    printf '%s\n' "$fetch_batch" | sed 's/^/  /'
    return 0
  fi

  # bash 3.2 renders an empty array as one empty word under set -u, so both expansions
  # below are count-guarded rather than trusted to iterate zero times.
  local -a missing_arr=() fetch_arr=()
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    missing_arr+=("$entry")
  done <<<"$missing"
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    fetch_arr+=("$entry")
  done <<<"$fetch_batch"

  echo "Homebrew ran, but these Brewfile entries don't exist (its errors are above):"
  printf '%s\n' "$missing" | sed 's/^/  /'

  if [ "$allow_retry" -eq 1 ] && [ "${#missing_arr[@]}" -lt "${#fetch_arr[@]}" ]; then
    # At least one batched name resolves, so the registry isn't entirely to blame — drop
    # only the dead lines and give the survivors the run they never got, since
    # installer.rb's fetch phase returns before installing anything at all. Gating on the
    # count comparison (not on whether the trimmed Brewfile is merely non-empty) matters:
    # the fetch batch is a handful of entries out of dozens in the full Brewfile, so
    # "the Brewfile still has lines in it" stays true even when every batched name is dead.
    local retry_brewfile="$brewfile" entry
    for entry in "${missing_arr[@]}"; do
      retry_brewfile=$(printf '%s\n' "$retry_brewfile" | grep -vF "\"$entry\"")
    done

    retry_log=$(mktemp -t dotfiles-brew-bundle-retry)
    brew bundle --file=/dev/stdin <<<"$retry_brewfile" 2>&1 | tee "$retry_log"
    local retry_status=${PIPESTATUS[0]}

    handle_bundle_result "$retry_log" "$retry_status" 0
  fi
}

# The guard this replaces was `|| echo "Some Brewfile entries failed"`, put there because a
# MAS app can need interactive sudo and must not abort the apply. It worked, and it also
# meant a count where a name belonged: on 2026-08-06 fzf joined the core bundle, brew never
# installed it, and the run said the same thing it says on a machine that is merely waiting
# on an App Store password. Keep the run's own output on screen and keep a copy to read the
# names back out of. $retry_log is unset unless handle_bundle_result actually retries; an
# unset trap reference just expands empty, so rm -f no-ops on the happy path instead of
# needing a second trap registration.
bundle_log=$(mktemp -t dotfiles-brew-bundle)
# $? first, before the removals: rm -f always returns 0, so a finalizer reading
# it afterward settles a failed run as a success.
ui_exit() {
  ui_st=$?
  rm -f "$bundle_log" "$retry_log"
  ui_finalize "$ui_st"
}
trap ui_exit EXIT

# The step line opens here, before brew is entered, and closes after it exits.
# Nothing is drawn in between on purpose: a cask's sudo prompt writes to
# /dev/tty past any redirect, onto the same stream a spinner would redraw, so a
# frame landing there can erase a password prompt and hang the apply on
# something nobody was shown. The live display for this script is GitHub #33.
step_begin "packages"

# tee rather than capture-then-print: a fresh machine spends tens of minutes in here and
# needs to see it working. PIPESTATUS[0] is brew's status; $? would be tee's, always 0.
brew bundle --file=/dev/stdin <<<"$brewfile" 2>&1 | tee "$bundle_log"
bundle_status=${PIPESTATUS[0]}

handle_bundle_result "$bundle_log" "$bundle_status" 1

if [ "$bundle_status" -eq 0 ]; then
  step_ok "packages" "Brewfile applied"
else
  step_warn "packages" "Homebrew reported failures"
fi

# Still 0, having named the failures. Stopping the apply here would strand every later
# script over one unavailable formula; dotfiles-doctor is what carries the gap forward.
exit 0
