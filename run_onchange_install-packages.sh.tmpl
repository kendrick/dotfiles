#!/bin/bash
# Brewfile hash: {{ includeTemplate "Brewfile" . | sha256sum }}
# Re-runs whenever the rendered Brewfile changes. Hashing the render rather than the
# template file is what makes this react to .chezmoidata.toml edits and to a machine
# turning a bundle on or off. The template itself now holds no package names at all.
#
# Installs apps. Teardown deliberately stops short of uninstalling them.
#
# teardown:none

if ! command -v brew &>/dev/null; then
  echo "Homebrew not found — skipping package install."
  exit 0
fi

brewfile=$(cat <<'BREWEOF'
{{ template "Brewfile" . }}
BREWEOF
)

# Homebrew 6 refuses to load formulae/casks from third-party taps unless they're
# trusted, so one untrusted tap aborts `brew bundle` on its first tapped entry and
# silently drops everything after it. Trust every tap the Brewfile declares up front;
# keying off the rendered Brewfile means new taps (and the work-only ones) are covered
# without editing this script.
echo "$brewfile" | awk '/^tap /{gsub(/"/,"",$2); print $2}' | while read -r tap; do
  brew trust --tap "$tap" 2>/dev/null || true
done

# The guard this replaces was `|| echo "Some Brewfile entries failed"`, put there because a
# MAS app can need interactive sudo and must not abort the apply. It worked, and it also
# meant a count where a name belonged: on 2026-08-06 fzf joined the core bundle, brew never
# installed it, and the run said the same thing it says on a machine that is merely waiting
# on an App Store password. Keep the run's own output on screen and keep a copy to read the
# names back out of.
bundle_log=$(mktemp -t dotfiles-brew-bundle)
trap 'rm -f "$bundle_log"' EXIT

# tee rather than capture-then-print: a fresh machine spends tens of minutes in here and
# needs to see it working. PIPESTATUS[0] is brew's status; $? would be tee's, always 0.
brew bundle --file=/dev/stdin <<<"$brewfile" 2>&1 | tee "$bundle_log"
bundle_status=${PIPESTATUS[0]}

if [ "$bundle_status" -ne 0 ]; then
  # brew names each failing entry as "<Verb> <entry> has failed!" on stderr, where Verb is
  # Installing, Upgrading, or Tapping, and wraps it in red when stdout is a terminal — so
  # strip SGR escapes first or an interactive apply matches nothing. brew's own closing
  # line, "Homebrew Bundle failed! N Brewfile dependencies failed to install.", deliberately
  # does not match this shape: it carries a count, and a count is what hid fzf.
  failed_entries=$(awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /^[A-Za-z]+ .+ has failed!$/) {
        sub(/^[A-Za-z]+ /, "", line)
        sub(/ has failed!$/, "", line)
        print line
      }
    }
  ' "$bundle_log")

  # The other phase. brew batch-fetches everything that needs downloading before it
  # installs anything, and installer.rb:84-87 returns on a fetch failure — so the install
  # phase never runs and none of the per-entry lines the awk above wants can exist. The
  # only line this phase emits joins every entry that needed fetching, guilty or not: the
  # #17 e2e saw six names for one bad formula. Parsing it would have blamed five packages
  # whose sole crime was not being downloaded yet.
  fetch_batch=$(awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /Failed to fetch /) {
        sub(/^.*Failed to fetch /, "", line)
        gsub(/, /, "\n", line)
        print line
      }
    }
  ' "$bundle_log")

  if [ -n "$failed_entries" ]; then
    echo "Homebrew ran, but could not install these Brewfile entries (its errors are above):"
    printf '%s\n' "$failed_entries" | sed 's/^/  /'
  elif [ -n "$fetch_batch" ]; then
    # Re-derive rather than parse. Asking brew which of the batch actually resolves is what
    # separates a typo in the registry from a download that failed, and it doesn't depend on
    # the shape of an error string — the assumption that produced this bug in the first place.
    # `brew info` answers for casks and formulae alike without downloading anything.
    missing=$(while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      brew info "$entry" >/dev/null 2>&1 || printf '%s\n' "$entry"
    done <<<"$fetch_batch")

    if [ -n "$missing" ]; then
      echo "Homebrew ran, but these Brewfile entries don't exist (its errors are above):"
      printf '%s\n' "$missing" | sed 's/^/  /'
    else
      # Every name resolves, so the registry is fine and the download isn't. Naming the whole
      # batch is the honest answer here; singling one out would be a guess.
      echo "Homebrew could not fetch these Brewfile entries, though all of them exist (its errors are above):"
      printf '%s\n' "$fetch_batch" | sed 's/^/  /'
    fi
  else
    # brew failed in a shape this script does not recognise. Saying so beats saying nothing,
    # which is the silence the whole change exists to end.
    echo "Homebrew ran and exited $bundle_status without naming a failed entry. Its output is above."
  fi
fi

# Still 0, having named the failures. Stopping the apply here would strand every later
# script over one unavailable formula; dotfiles-doctor is what carries the gap forward.
exit 0
