#!/bin/bash
# Brewfile hash: {{ includeTemplate "Brewfile" . | sha256sum }}
# Re-runs whenever the rendered Brewfile changes. Hashing the render rather than the
# template file is what makes this react to .chezmoidata.toml edits and to a machine
# turning a bundle on or off. The template itself now holds no package names at all.
#
# Installs apps. Teardown deliberately stops short of uninstalling them.
#
# teardown:none

{{ template "sh-ui.sh" . }}

if ! command -v brew &>/dev/null; then
  step_warn "packages" "Homebrew not found"
  exit 0
fi

brewfile=$(cat <<'BREWEOF'
{{ template "Brewfile" . }}
BREWEOF
)

# Homebrew 6 refuses to load formulae/casks from third-party taps unless they're
# trusted, so one untrusted tap aborts `brew bundle` on its first tapped entry and
# silently drops everything after it. Trust every tap the Brewfile declares up front;
# keying off the rendered Brewfile means new taps (and the work-only ones) are covered
# without editing this script.
echo "$brewfile" | awk '/^tap /{gsub(/"/,"",$2); print $2}' | while read -r tap; do
  brew trust --tap "$tap" 2>/dev/null || true
done

# brew names each failing entry as "<Verb> <entry> has failed!" on stderr, where Verb is
# Installing, Upgrading, or Tapping, and wraps it in red when stdout is a terminal — so
# strip SGR escapes first or an interactive apply matches nothing. brew's own closing
# line, "Homebrew Bundle failed! N Brewfile dependencies failed to install.", deliberately
# does not match this shape: it carries a count, and a count is what hid fzf. Factored out
# because #22's retry needs this same read applied to a second log, not just the first.
parse_failed_entries() {
  awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /^[A-Za-z]+ .+ has failed!$/) {
        sub(/^[A-Za-z]+ /, "", line)
        sub(/ has failed!$/, "", line)
        print line
      }
    }
  ' "$1"
}

# The other phase. brew batch-fetches everything that needs downloading before it
# installs anything, and installer.rb:84-87 returns on a fetch failure — so the install
# phase never runs and none of the per-entry lines the parser above wants can exist. The
# only line this phase emits joins every entry that needed fetching, guilty or not: the
# #17 e2e saw six names for one bad formula. Parsing it would have blamed five packages
# whose sole crime was not being downloaded yet.
parse_fetch_batch() {
  awk '
    {
      line = $0
      gsub(/\033\[[0-9;]*m/, "", line)
      if (line ~ /Failed to fetch /) {
        sub(/^.*Failed to fetch /, "", line)
        gsub(/, /, "\n", line)
        print line
      }
    }
  ' "$1"
}

# The moment brew stops being silent, as a regex over its log.
#
# parallel_installer.rb:298 prints "#{verb} #{name}" where verb is Installing or
# Upgrading, and :301 prints "Using #{name}" for an entry already satisfied.
# Matching only Installing would miss the upgrade case, and an upgrading cask is
# the entry most likely to ask for a password.
#
# Every part of this leans toward matching too eagerly, because the two failure
# directions are not comparable. Matching a line early costs some animation
# nobody will miss. Failing to match costs the spinner running on into the phase
# where a cask's sudo prompt owns /dev/tty, which is a hung apply.
#
# So both prefixes are tolerated on the cheap side of that trade. brew writes no
# color into a file, and neither of these two lines carries the `==>` some of
# its others do, but a gate that shrugs at both survives the day one of them
# changes.
BUNDLE_GATE_RE=$'^(\033\\[[0-9;]*m)*(==> )?(Installing|Upgrading|Using) '

# How many Brewfile entries brew will have to go and get: everything declared
# that this machine doesn't already have.
#
# Derived here, ahead of brew, and deliberately not read back out of brew's own
# output. The line that would carry it is `Fetching <names>`, which brew has
# reworded across releases and suppresses entirely under --quiet, so a display
# reading it breaks on an upgrade that changes neither this script nor the
# Brewfile.
#
# Every inventory read is guarded, and every failure lands the same way, on an
# overcount. A `brew list` that errors reads as an empty machine, so entries the
# machine already has get counted as absent and the line says a number that is
# too big. That is a wrong caption on a spinner, and nothing here may cost more
# than that: this function runs ahead of an apply that installs software, and a
# count is no reason to interfere with one.
#
# Formula and cask names carry their tap when they come from one
# (`fkhadra/cli/caniuse`) while `brew list` answers in short names, so both
# compare on the last path segment. Taps compare whole, since that IS the name.
count_absent_entries() {
  local nl=$'\n'
  local formulae casks taps mas_ids line name id count=0
  formulae="$nl$(brew list -1 --formula 2>/dev/null || true)$nl"
  casks="$nl$(brew list -1 --cask 2>/dev/null || true)$nl"
  taps="$nl$(brew tap 2>/dev/null || true)$nl"
  # No mas means no App Store apps installed through it, so every mas entry is
  # absent. That is the honest answer: brew bundle installs mas first and then
  # goes and fetches all of them.
  mas_ids="$nl"
  if command -v mas >/dev/null 2>&1; then
    mas_ids="$nl$(mas list 2>/dev/null | awk '{print $1}' || true)$nl"
  fi

  # Membership by pattern match rather than by `grep -qxF`, which would fork
  # twice per entry across ninety-odd of them every time this script runs.
  # Quoted case patterns match literally, so a name holding a `*` or a `?` is
  # compared as text rather than expanded.
  while IFS= read -r line; do
    case "$line" in
    'tap "'*)
      name=${line#*\"}
      name=${name%%\"*}
      case "$taps" in *"$nl$name$nl"*) ;; *) count=$((count + 1)) ;; esac
      ;;
    'brew "'*)
      name=${line#*\"}
      name=${name%%\"*}
      name=${name##*/}
      case "$formulae" in *"$nl$name$nl"*) ;; *) count=$((count + 1)) ;; esac
      ;;
    'cask "'*)
      name=${line#*\"}
      name=${name%%\"*}
      name=${name##*/}
      case "$casks" in *"$nl$name$nl"*) ;; *) count=$((count + 1)) ;; esac
      ;;
    'mas "'*)
      id=${line##*id: }
      case "$mas_ids" in *"$nl$id$nl"*) ;; *) count=$((count + 1)) ;; esac
      ;;
    esac
  done <<<"$brewfile"

  printf '%s' "$count"
  return 0
}

# Copies $bundle_log onto stdout from $bundle_offset to wherever it currently
# ends, and remembers the new end.
#
# By byte, not by line. A line-oriented read holds back a partial last line,
# which is exactly what a prompt or a progress carriage return looks like. The
# copy reformats, wraps, and filters nothing: what brew wrote is what stdout
# gets.
#
# A read that fails streams nothing this pass rather than guessing. The caller's
# final drain after `wait` is what makes the copy whole regardless, since by then
# brew has exited and the log has stopped moving.
stream_bundle_log() {
  local size
  size=$(wc -c <"$bundle_log" 2>/dev/null | tr -d ' ' || printf 0)
  case "$size" in
  '' | *[!0-9]*) return 0 ;;
  esac
  [ "$size" -gt "$bundle_offset" ] || return 0
  tail -c "+$((bundle_offset + 1))" "$bundle_log" 2>/dev/null |
    head -c "$((size - bundle_offset))" || true
  bundle_offset=$size
  return 0
}

# Reports one completed `brew bundle` attempt and, the first time only, retries. $log is
# wherever that attempt's output was collected, $status is brew's own exit code and never
# a pipeline's, and
# $allow_retry is 1 for the initial attempt and 0 for the retry this function may itself
# trigger — #17 already ruled out looping the apply, so a second failure of either phase
# is always just reported, never retried again.
handle_bundle_result() {
  local log="$1" status="$2" allow_retry="$3"
  local failed_entries fetch_batch missing

  # Recorded rather than inferred by the caller, because the caller only ever
  # sees the FIRST bundle's status and a retry that succeeds would otherwise be
  # reported as a failure. The retry reaches this same early return through the
  # recursive call below.
  [ "$status" -eq 0 ] && {
    bundle_outcome=ok
    return 0
  }

  failed_entries=$(parse_failed_entries "$log")
  if [ -n "$failed_entries" ]; then
    echo "Homebrew ran, but could not install these Brewfile entries (its errors are above):"
    printf '%s\n' "$failed_entries" | sed 's/^/  /'
    return 0
  fi

  fetch_batch=$(parse_fetch_batch "$log")
  if [ -z "$fetch_batch" ]; then
    # brew failed in a shape this script does not recognise. Saying so beats saying
    # nothing, which is the silence the whole change exists to end.
    echo "Homebrew ran and exited $status without naming a failed entry. Its output is above."
    return 0
  fi

  # Re-derive rather than parse. Asking brew which of the batch actually resolves is what
  # separates a typo in the registry from a download that failed, and it doesn't depend on
  # the shape of an error string — the assumption that produced this bug in the first place.
  # `brew info` answers for casks and formulae alike without downloading anything.
  missing=$(while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    brew info "$entry" >/dev/null 2>&1 || printf '%s\n' "$entry"
  done <<<"$fetch_batch")

  if [ -z "$missing" ]; then
    # Every name resolves, so the registry is fine and the download isn't. Naming the whole
    # batch is the honest answer here; singling one out would be a guess.
    echo "Homebrew could not fetch these Brewfile entries, though all of them exist (its errors are above):"
    printf '%s\n' "$fetch_batch" | sed 's/^/  /'
    return 0
  fi

  # bash 3.2 renders an empty array as one empty word under set -u, so both expansions
  # below are count-guarded rather than trusted to iterate zero times.
  local -a missing_arr=() fetch_arr=()
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    missing_arr+=("$entry")
  done <<<"$missing"
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    fetch_arr+=("$entry")
  done <<<"$fetch_batch"

  echo "Homebrew ran, but these Brewfile entries don't exist (its errors are above):"
  printf '%s\n' "$missing" | sed 's/^/  /'

  if [ "$allow_retry" -eq 1 ] && [ "${#missing_arr[@]}" -lt "${#fetch_arr[@]}" ]; then
    # At least one batched name resolves, so the registry isn't entirely to blame — drop
    # only the dead lines and give the survivors the run they never got, since
    # installer.rb's fetch phase returns before installing anything at all. Gating on the
    # count comparison (not on whether the trimmed Brewfile is merely non-empty) matters:
    # the fetch batch is a handful of entries out of dozens in the full Brewfile, so
    # "the Brewfile still has lines in it" stays true even when every batched name is dead.
    local retry_brewfile="$brewfile" entry
    for entry in "${missing_arr[@]}"; do
      retry_brewfile=$(printf '%s\n' "$retry_brewfile" | grep -vF "\"$entry\"")
    done

    retry_log=$(mktemp -t dotfiles-brew-bundle-retry)
    brew bundle --file=/dev/stdin <<<"$retry_brewfile" 2>&1 | tee "$retry_log"
    local retry_status=${PIPESTATUS[0]}

    handle_bundle_result "$retry_log" "$retry_status" 0
  fi
}

# The guard this replaces was `|| echo "Some Brewfile entries failed"`, put there because a
# MAS app can need interactive sudo and must not abort the apply. It worked, and it also
# meant a count where a name belonged: on 2026-08-06 fzf joined the core bundle, brew never
# installed it, and the run said the same thing it says on a machine that is merely waiting
# on an App Store password. Keep the run's own output on screen and keep a copy to read the
# names back out of. $retry_log is unset unless handle_bundle_result actually retries; an
# unset trap reference just expands empty, so rm -f no-ops on the happy path instead of
# needing a second trap registration.
bundle_log=$(mktemp -t dotfiles-brew-bundle)
# $? first, before the removals: rm -f always returns 0, so a finalizer reading
# it afterward settles a failed run as a success.
ui_exit() {
  ui_st=$?
  rm -f "$bundle_log" "$retry_log"
  ui_finalize "$ui_st"
}
trap ui_exit EXIT

# The step line opens here and settles after brew exits. In between the
# installer owns one live line, and only for as long as brew has nothing to say.
#
# brew runs in two phases and they want opposite things. The fetch phase names
# everything it is about to download in one line and then goes quiet for as long
# as the downloads take, which on a fresh machine is tens of minutes on one
# unchanging line—the silence this display exists to end. The install phase
# that follows narrates itself an entry at a time, and it also hands /dev/tty to
# a cask's sudo prompt, which writes there past every redirect. A frame redrawn
# onto that stream can erase "Password:" a hundred milliseconds after it appears,
# and the apply then blocks forever on a question nobody was shown.
#
# So the animation stops at brew's first install-phase line and never comes
# back. That is structural rather than careful: the only call that can draw is
# the one below, ahead of the first invocation, and the retry inside
# handle_bundle_result has no path to it.
#
# While the line is live brew's bytes go to $bundle_log alone, because a tool
# printing next to a live line lands on the live line's own row (#38). Nothing
# is lost to that: everything withheld is replayed to stdout the moment the line
# is gone, and the rest of the run streams as brew writes it.
bundle_outcome=failed
step_begin_quiet "packages"

fetch_count=$(count_absent_entries)
case "$fetch_count" in
'' | *[!0-9]*) fetch_count=0 ;;
esac
fetch_noun=entries
[ "$fetch_count" -ne 1 ] || fetch_noun=entry

if ui_watching; then
  brew bundle --file=/dev/stdin <<<"$brewfile" >"$bundle_log" 2>&1 &
  bundle_pid=$!
  spin_until_log_gate "$bundle_pid" \
    "packages  fetching $fetch_count $fetch_noun" "$bundle_log" "$BUNDLE_GATE_RE"

  # The line is gone for good, so brew gets the screen back: everything it wrote
  # while it was silent, then the rest as it arrives. Polling rather than tailing
  # keeps the wait for brew's status in this shell, where a `tail -f` would put a
  # second process between us and it.
  bundle_offset=0
  while kill -0 "$bundle_pid" 2>/dev/null; do
    stream_bundle_log
    sleep 0.2
  done
  bundle_status=0
  wait "$bundle_pid" || bundle_status=$?
  # brew has exited, so this pass reaches a log that has stopped moving and the
  # copy on stdout is whole no matter what any earlier pass missed.
  stream_bundle_log
else
  # No terminal and no live line, so there is no screen to withhold anything
  # from and brew streams straight through. tee rather than capture-then-print:
  # a fresh machine spends tens of minutes in here, and a captured apply needs
  # to show it working. PIPESTATUS[0] is brew's status; $? would be tee's,
  # always 0.
  say "packages: fetching $fetch_count $fetch_noun"
  brew bundle --file=/dev/stdin <<<"$brewfile" 2>&1 | tee "$bundle_log"
  bundle_status=${PIPESTATUS[0]}
fi

handle_bundle_result "$bundle_log" "$bundle_status" 1

if [ "$bundle_outcome" = "ok" ]; then
  step_ok "packages" "Brewfile applied"
else
  step_warn "packages" "Homebrew reported failures"
fi

# Still 0, having named the failures. Stopping the apply here would strand every later
# script over one unavailable formula; dotfiles-doctor is what carries the gap forward.
exit 0
